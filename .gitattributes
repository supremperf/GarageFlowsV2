# Prevent git from doing CRLF conversion on binary files
*.db        binary
*.db-shm    binary
*.db-wal    binary
*.ico       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.pdf       binary
*.pem       binary
*.exe       binary
*.dll       binary
*.node      binary

# Scripts Windows : CRLF volontaire, pas un espace final accidentel.
*.ps1 whitespace=cr-at-eol
*.cmd whitespace=cr-at-eol
