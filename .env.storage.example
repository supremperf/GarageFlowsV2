# Entrées canoniques de configuration fournisseur — aucune vraie valeur ici.
# Les exports bruts des dashboards sont acceptés à la frontière node config,
# normalisés avant export ; conflits de connexion directe refusés.
# N'utiliser que des ressources propres à la cible development/preview/production.
DATABASE_URL=
DIRECT_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Outil de configuration Blob seulement ; aucun consommateur applicatif actuel.
BLOB_READ_WRITE_TOKEN=
