{
  "name": "garageflow",
  "version": "1.1.0",
  "license": "UNLICENSED",
  "productName": "GarageFlows",
  "description": "Logiciel de gestion et planning d'atelier automobile — version desktop",
  "author": "GarageFlows",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "predev": "node scripts/setup-dev.js",
    "dev": "next dev",
    "predev:electron": "node scripts/setup-dev.js",
    "dev:electron": "next dev -p 4028",
    "build": "prisma generate && prisma generate --schema prisma/server/schema.prisma && node scripts/next-build.cjs",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "postinstall": "node scripts/setup-dev.js && prisma generate && prisma generate --schema prisma/server/schema.prisma",
    "setup": "node scripts/setup-dev.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:desktop:generate": "prisma generate",
    "db:desktop:push": "prisma db push",
    "db:desktop:validate": "prisma validate",
    "db:server:generate": "prisma generate --schema prisma/server/schema.prisma",
    "db:server:validate": "node scripts/validate-server-schema.mjs",
    "db:server:migrate": "prisma migrate dev --schema prisma/server/schema.prisma",
    "db:server:deploy": "prisma migrate deploy --schema prisma/server/schema.prisma",
    "db:server:check": "node scripts/validate-server-db.js",
    "db:server:migrate-json": "ts-node --project tsconfig.scripts.json scripts/migrate-money-json.ts",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "demo:seed": "ts-node --project tsconfig.seed.json prisma/demo-tenant.ts seed",
    "demo:reset": "ts-node --project tsconfig.seed.json prisma/demo-tenant.ts reset",
    "demo:wipe": "ts-node --project tsconfig.seed.json prisma/demo-tenant.ts wipe",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "icons": "node scripts/generate-icons.js",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "dist": "npm run preflight:release && cross-env GF_PACKAGE_DESKTOP=1 npm run build && npm run verify:standalone && electron-builder --win --x64 --publish never && npm run check:artifact-secrets && npm run check:artifact-fuses && npm run verify:installer",
    "dist:win": "npm run dist",
    "license:gen": "python scripts/keygen.py --gen",
    "licences:campagne": "node scripts/campagne-100-licences.mjs",
    "rapport:parcours": "node scripts/rapport-10-parcours.mjs",
    "test:keygen-hwid": "python3 scripts/test_keygen_hwid_binding.py",
    "env:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configurer-api-garageflow.ps1",
    "env:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configurer-api-garageflow.ps1 -CheckOnly",
    "env:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-garageflow.ps1",
    "env:reset:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-garageflow.ps1 -DryRun",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:branding": "node scripts/check-branding.mjs",
    "check:docs": "node scripts/check-docs-consistency.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:money": "node scripts/check-money-fields.mjs",
    "check:money-calculations": "node scripts/check-money-calculations.mjs",
    "check:money-json": "node scripts/check-money-json.mjs",
    "check:env-consistency": "node scripts/check-env-consistency.mjs",
    "check:env-contract": "node scripts/check-env-consistency.mjs --rapport",
    "check:env-vercel": "node scripts/check-env-vercel.mjs",
    "env:doc": "node scripts/generate-env-doc.mjs",
    "check:migration-safety": "node scripts/check-migration-safety.mjs",
    "check:sqlite-template": "node scripts/check-sqlite-template.mjs",
    "check:pg-migrations": "node scripts/check-postgres-migration-verification.mjs",
    "verify:rotation": "node scripts/verify-rotation.mjs",
    "check:critical-files": "node scripts/check-critical-files.js",
    "check:public-key": "node scripts/check-public-key.mjs",
    "keys:sync": "node scripts/sync-public-key.mjs",
    "keys:check": "node scripts/sync-public-key.mjs --check",
    "keys:restore": "node scripts/restore-public-anchors.cjs",
    "keys:find-issuer": "node scripts/find-issuer-key.cjs",
    "check:converge-additive": "node scripts/check-converge-additive.mjs",
    "check:perf-budget": "node scripts/check-perf-budget.mjs",
    "check:desktop-audit": "node scripts/check-desktop-runtime-audit.mjs",
    "recette:themes": "node scripts/recette-visuelle-themes.mjs",
    "release:gate": "node scripts/final-release-gate.mjs",
    "release:publish": "node scripts/check-version.js && npm run release:gate && npm run dist && npm run release:sign",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:sign": "node scripts/config-release.cjs",
    "release:sign:gen-key": "node scripts/sign-release-manifest.mjs --gen-key",
    "release:verify-artifact": "node scripts/verify-artifact.mjs",
    "release:artifact": "node scripts/package-artifact.mjs --verify",
    "release:gate:fast": "node scripts/final-release-gate.mjs --fast",
    "verify:baseline": "vitest run --reporter=json --outputFile=artifacts/verification/test-results.json && node scripts/generate-verification-baseline.mjs",
    "baseline:generate": "vitest run --reporter=json --outputFile=artifacts/verification/test-results.json && node scripts/generate-verification-baseline.mjs",
    "docs:check": "node scripts/check-docs-consistency.mjs",
    "check:consistency": "npm run check:branding && npm run check:docs && npm run check:pwa && npm run check:money && npm run check:money-calculations && npm run check:money-json && npm run check:env-consistency && npm run check:migration-safety && npm run check:sqlite-template && npm run check:pg-migrations && npm run check:converge-additive && npm run check:critical-files && npm run check:public-key && npm run keys:check",
    "test:money": "vitest run src/lib/__tests__/money.test.ts src/lib/__tests__/money-migration.test.ts src/lib/__tests__/money-document-consistency.test.ts src/lib/__tests__/tva.test.ts",
    "test:money-json": "vitest run src/lib/__tests__/money-json.test.ts",
    "test:sqlite-migrations": "vitest run src/lib/__tests__/money-schema-migration.test.ts",
    "test:migration-failures": "vitest run src/lib/__tests__/money-schema-migration.test.ts src/lib/__tests__/pre-migration-backup.test.ts",
    "test:postgres-migrations": "node scripts/validate-server-db.js",
    "test:migration": "vitest run src/lib/__tests__/money-schema-migration.test.ts src/lib/__tests__/money-json.test.ts src/lib/__tests__/pre-migration-backup.test.ts src/lib/__tests__/user-data-path.test.ts",
    "typecheck": "tsc --noEmit",
    "check:artifact-secrets": "node scripts/check-artifact-secrets.mjs",
    "check:artifact-fuses": "node scripts/check-artifact-fuses.mjs",
    "config": "node config",
    "config:check": "node config --check",
    "test:config": "node --test tests/config.test.cjs tests/config-full.test.cjs tests/config-secrets-auto.test.cjs tests/config-rebuild.test.cjs tests/config-storage-discovery.test.cjs tests/config-manager.test.cjs",
    "config:audit": "node scripts/config-audit.cjs",
    "keygen": "node scripts/config-keygen.cjs",
    "audit:strict": "node scripts/audit-ci.js",
    "test:audit": "node --max-old-space-size=256 --test --test-timeout=15000 tests/audit-security.test.cjs tests/critical-dependency-regressions.test.cjs tests/github-security-report.test.cjs",
    "test:release-safety": "node --test tests/package-prisma-resources.test.cjs tests/build-public-key.test.cjs tests/ci-required-gate.test.cjs tests/preload-listeners.test.cjs tests/preserve-legacy-dev-db.test.cjs tests/secret-scan-policy.test.cjs tests/pre-migration-backup-safety.test.cjs tests/gitleaks-ci.test.cjs tests/build-dist-chain.test.cjs tests/windows-delivery.test.cjs tests/desktop-server-ready.test.cjs tests/desktop-database-preservation.test.cjs tests/private-key-material.test.cjs tests/installed-runtime-modules.test.cjs tests/file-snapshot.test.cjs tests/private-file-ownership.test.cjs tests/electron-http-json.test.cjs tests/next-build-home.test.cjs tests/restore-public-anchors.test.cjs tests/find-issuer-key.test.cjs tests/env-artifact-check.test.cjs tests/evidence-artifact-secrets.test.cjs",
    "postbuild": "node scripts/post-build.js",
    "verify:standalone": "node scripts/verify-standalone-build.cjs",
    "preflight:release": "node scripts/preflight-release.cjs",
    "verify:installer": "node scripts/verify-installer.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.16.1",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.8",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.400.0",
    "next": "15.5.27",
    "next-auth": "^4.24.15",
    "nodemailer": "10.1.1",
    "prisma": "^5.16.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^2.4.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@garageflows/braces-bounded": "file:vendor/braces-bounded",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vercel/blob": "2.8.2",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10",
    "cross-env": "^7.0.3",
    "electron": "41.10.6",
    "electron-builder": "26.15.3",
    "eslint": "^8",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.25",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.garageflow.app",
    "productName": "GarageFlows",
    "copyright": "Copyright © 2026 GarageFlows",
    "afterPack": "scripts/afterPack.js",
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma/client/query_engine-windows*",
      "node_modules/@prisma/engines/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!**/*.before-*",
      "!**/*.bak",
      "!**/*.backup",
      "!**/*.old",
      "!**/*.orig",
      "!**/*.rej",
      "!**/*~",
      "!**/*.tmp",
      "!**/.env*",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.log",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "schema.prisma",
          "garageflow-template.db"
        ]
      },
      {
        "from": "keys",
        "to": "keys",
        "filter": [
          "public.pem"
        ]
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GarageFlows",
      "include": "scripts/installer.nsh",
      "warningsAsErrors": false,
      "artifactName": "GarageFlows-Setup.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "overrides": {
    "postcss": "$postcss",
    "nodemailer": "$nodemailer",
    "braces": "file:vendor/braces-bounded",
    "postcss-selector-parser": "7.1.6",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^5.0.0": "5.0.12",
    "picomatch@^2.0.0": "2.3.2",
    "fflate": "0.8.3",
    "js-yaml@^4.0.0": "4.3.2",
    "browserslist": "4.29.3",
    "baseline-browser-mapping": "2.11.28",
    "global-agent": "4.1.3"
  },
  "packageManager": "npm@11.16.0"
}
