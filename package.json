{
  "name": "garageflow",
  "version": "1.1.0",
  "productName": "GarageFlow",
  "description": "Logiciel de gestion et planning d'atelier automobile — version desktop",
  "author": "GarageFlow",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "predev": "node scripts/setup-dev.js",
    "dev": "next dev",
    "predev:electron": "node scripts/setup-dev.js",
    "dev:electron": "next dev -p 4028",
    "build": "prisma generate && prisma generate --schema prisma/server/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/setup-dev.js && prisma generate && prisma generate --schema prisma/server/schema.prisma",
    "setup": "node scripts/setup-dev.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:desktop:generate": "prisma generate",
    "db:desktop:push": "prisma db push",
    "db:desktop:validate": "prisma validate",
    "db:server:generate": "prisma generate --schema prisma/server/schema.prisma",
    "db:server:validate": "prisma validate --schema prisma/server/schema.prisma",
    "db:server:migrate": "prisma migrate dev --schema prisma/server/schema.prisma",
    "db:server:deploy": "prisma migrate deploy --schema prisma/server/schema.prisma",
    "db:server:check": "node scripts/validate-server-db.js",
    "db:seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "icons": "node scripts/generate-icons.js",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "brand:apply": "node scripts/apply-brand.js",
    "brand:check": "node scripts/apply-brand.js --check",
    "predist": "node scripts/apply-brand.js",
    "dist": "npm run build && node scripts/post-build.js && electron-builder --win --x64",
    "dist:win": "npm run dist",
    "license:gen": "python scripts\\keygen.py --gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "compliance:check": "node scripts/check-compliance-language.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.16.1",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.3.8",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.400.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "prisma": "^5.16.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^2.4.0",
    "uuid": "^10.0.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.25",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.garageflow.app",
    "productName": "GarageFlow",
    "copyright": "Copyright © 2026 GarageFlow",
    "afterPack": "scripts/afterPack.js",
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma/client/query_engine-windows*",
      "node_modules/@prisma/engines/**"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": "prisma",
        "to": "prisma",
        "filter": [
          "schema.prisma",
          "*.db"
        ]
      },
      {
        "from": "keys",
        "to": "keys",
        "filter": [
          "public.pem"
        ]
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "rfc3161TimeStampServer": "http://timestamp.digicert.com",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GarageFlow",
      "include": "scripts/installer.nsh",
      "warningsAsErrors": false
    }
  }
}
