#!/usr/bin/env node
'use strict'
/** GarageFlow configuration wizard. Run with Node 22, no application dependencies needed. */
const fs = require('node:fs')
const path = require('node:path')
const readline = require('node:readline')
const { Writable } = require('node:stream')
const { spawn } = require('node:child_process')
const crypto = require('node:crypto')
const core = require('./scripts/config-core.cjs')
const ROOT = __dirname
const args = process.argv.slice(2)
const PROFILES = ['desktop', 'pwa', 'licences']
const TOOLS = { vercel: 'vercel@64.0.2', neonctl: 'neonctl@8.4.4' }
const template = fs.readFileSync(path.join(ROOT, '.env.example'), 'utf8')
// Canonical template + timeout consumed by src/lib/env.ts, absent from the older template.
const allNames = [...new Set([...core.templateNames(template), 'UPSTASH_REDIS_TIMEOUT_MS'])]
const safeLabel = s => String(s).replace(/[\x00-\x1f\x7f]/g, '').slice(0, 160)

function help() {
  console.log(`GarageFlow — assistant config (Node 22)

  npm run config                     Assistant interactif
  node config --profile desktop      SQLite / Electron (développement local)
  node config --profile pwa           PostgreSQL / PWA
  node config --profile licences      PWA + autorité de licences
  node config --check --profile pwa   Validation locale, sans écriture ni réseau
  node config --check --profile pwa --vercel  Validation pour une cible Vercel
  node config --help

Fichiers : desktop → .env ; serveur → .env.server.local (isolé des builds Electron).
Aucun secret affiché, aucun remplacement automatique d'une valeur existante.
Neon/Vercel : authentification officielle dans votre navigateur, sur votre poste.
Migrations et déploiement uniquement sur confirmation explicite.
Guide détaillé : docs/CONFIG.md`)
}
async function question(label, { secret = false, defaultValue = '' } = {}) {
  if (!process.stdin.isTTY) throw new Error('Un terminal interactif est requis (ou utilisez --check / --help).')
  const prompt = `${label}${defaultValue ? ` [${secret ? 'déjà configuré' : safeLabel(defaultValue)}]` : ''} : `
  process.stdout.write(prompt)
  // A terminal readline with a muted output enables raw input without echoing passwords.
  const output = secret ? new Writable({ write(_chunk, _encoding, done) { done() } }) : process.stdout
  const rl = readline.createInterface({ input: process.stdin, output, terminal: true })
  try {
    return await new Promise((resolve, reject) => {
      rl.once('SIGINT', () => reject(new Error('Configuration annulée.')))
      rl.question('', value => resolve(value.trim() || defaultValue))
    })
  } finally { rl.close(); if (secret) process.stdout.write('\n') }
}
async function yes(label, defaultYes = false) {
  return /^(o|oui|y|yes)$/i.test(await question(`${label} (oui/non)`, { defaultValue: defaultYes ? 'oui' : 'non' }))
}
async function select(label, items) {
  if (!items.length) throw new Error(`${label} : aucun résultat. Créez la ressource dans le tableau de bord du fournisseur, puis relancez config.`)
  items.forEach((item, i) => console.log(`  ${i + 1}. ${safeLabel(item.name || item.id)}`))
  for (;;) {
    const i = Number(await question(label, { defaultValue: items.length === 1 ? '1' : '' })) - 1
    if (Number.isInteger(i) && items[i]) return items[i]
    console.log('Choisissez un numéro dans la liste.')
  }
}
function npmCli() {
  const candidates = [process.env.npm_execpath,
    path.join(path.dirname(process.execPath), 'node_modules/npm/bin/npm-cli.js'),
    path.join(path.dirname(process.execPath), '../lib/node_modules/npm/bin/npm-cli.js'),
    '/usr/share/nodejs/npm/bin/npm-cli.js']
  const found = candidates.find(p => p && /npm-cli\.js$/.test(p) && fs.existsSync(p))
  if (!found) throw new Error('npm introuvable. Lancez avec npm run config (Node 22 + npm requis).')
  return found
}
function execute(commandArgs, { interactive = false, input, env = process.env, label = 'Commande' } = {}) {
  return new Promise((resolve, reject) => {
    // No shell: project IDs, file paths and secrets can never become shell commands.
    const child = spawn(process.execPath, commandArgs, { cwd: ROOT, env,
      stdio: interactive ? 'inherit' : ['pipe', 'pipe', 'pipe'] })
    let stdout = ''
    if (!interactive) {
      child.stdout.setEncoding('utf8')
      child.stdout.on('data', chunk => { stdout += chunk })
      child.stderr.resume() // Never forward stderr: external tools may include credentials in errors.
      child.stdin.on('error', () => {})
      child.stdin.end(input === undefined ? undefined : input)
    }
    child.once('error', () => reject(new Error(`${label} : lancement impossible.`)))
    child.once('close', code => code === 0 ? resolve(stdout) : reject(new Error(`${label} : échec. Aucune validation revendiquée ; vérifiez votre connexion et vos droits, puis relancez.`)))
  })
}
function tool(name, commandArgs, options = {}) {
  return execute([npmCli(), 'exec', '--yes', `--package=${TOOLS[name]}`, '--', name, ...commandArgs],
    { ...options, label: options.label || name })
}
async function neonList(commandArgs, key) {
  const output = await tool('neonctl', [...commandArgs, '--output', 'json'])
  try {
    const data = JSON.parse(output)
    const list = Array.isArray(data) ? data : data[key]
    if (!Array.isArray(list)) throw new Error()
    return list
  } catch { throw new Error('Neon : format JSON inattendu, aucune valeur importée.') }
}
async function configureNeon(env) {
  console.log('\nConnexion Neon via le CLI officiel. Aucun jeton Neon stocké par config.')
  await tool('neonctl', ['auth'], { interactive: true })
  const orgs = await neonList(['orgs', 'list'], 'organizations')
  const org = orgs.length ? await select('Organisation Neon', orgs) : null
  const project = await select('Projet Neon', await neonList(['projects', 'list', ...(org ? ['--org-id', org.id] : [])], 'projects'))
  const branch = await select('Branche Neon (choisir la base cible)', await neonList(['branches', 'list', '--project-id', project.id], 'branches'))
  const scope = ['--project-id', project.id, '--branch', branch.id]
  const database = await select('Base Neon', await neonList(['databases', 'list', ...scope], 'databases'))
  const role = await select('Rôle PostgreSQL', await neonList(['roles', 'list', ...scope], 'roles'))
  const connectionArgs = ['connection-string', branch.id, '--project-id', project.id,
    '--database-name', database.name, '--role-name', role.name]
  // Neon returns the actual endpoints; no guessing by removing '-pooler'.
  env.DATABASE_URL = (await tool('neonctl', [...connectionArgs, '--pooled'])).trim()
  env.DIRECT_URL = (await tool('neonctl', connectionArgs)).trim()
  console.log('DATABASE_URL poolée et DIRECT_URL directe récupérées (valeurs masquées).')
}
async function pullVercel() {
  fs.mkdirSync(path.join(ROOT, 'GarageFlow-configuration'), { recursive: true, mode: 0o700 })
  const dir = fs.mkdtempSync(path.join(ROOT, 'GarageFlow-configuration/pull-'))
  fs.chmodSync(dir, 0o700)
  const file = path.join(dir, '.env.production.local')
  try {
    const raw = await tool('vercel', ['env', 'ls', 'production', '--format=json'])
    let records
    try {
      records = JSON.parse(raw).envs
      if (!Array.isArray(records)) throw new Error()
    } catch { throw new Error('Vercel : métadonnées JSON invalides, synchronisation refusée.') }
    await tool('vercel', ['env', 'pull', file, '--environment=production', '--yes'])
    fs.chmodSync(file, 0o600)
    const values = core.readEnv(file)
    const hidden = new Set()
    const present = new Set()
    const stamps = {}
    for (const r of records) {
      present.add(r.key)
      stamps[r.key] = JSON.stringify([r.updatedAt, r.createdAt, r.type, r.visibility, r.configurationId])
      // Sensitive values cannot be retrieved: never mistake a placeholder for an absent secret.
      if (r.type === 'sensitive' || r.visibility === 'secret' || !values[r.key]) {
        hidden.add(r.key)
        delete values[r.key]
      }
    }
    return { values, hidden, present, stamps }
  } finally { fs.rmSync(dir, { recursive: true, force: true }) }
}
async function setupVercel() {
  console.log('\nVercel : connexion puis sélection EXPLICITE du projet cible (production uniquement).')
  await tool('vercel', ['login'], { interactive: true })
  await tool('vercel', ['link'], { interactive: true })
  const project = JSON.parse(fs.readFileSync(path.join(ROOT, '.vercel/project.json'), 'utf8'))
  console.log(`Cible Vercel : ${safeLabel(project.projectName || project.projectId)} (équipe ${safeLabel(project.orgId)}).`)
  fs.mkdirSync(path.join(ROOT, 'GarageFlow-configuration'), { recursive: true, mode: 0o700 })
  return pullVercel()
}
async function importRemote(local, remote, names) {
  const conflicts = core.syncPlan(local, remote.values, names).conflicts
  if (conflicts.length) {
    console.log(`Valeurs locales différentes de Vercel : ${conflicts.join(', ')}.`)
    console.log('Conserver les clés de production évite de casser sessions, données chiffrées et licences.')
    if (!await yes('Utiliser les valeurs Vercel pour ce profil serveur (sans modifier Vercel)', true)) {
      throw new Error('Conflit non résolu. Rien synchronisé. Sauvegardez votre configuration avant de relancer.')
    }
  }
  const result = { ...local }
  for (const n of names) if (remote.values[n]) result[n] = remote.values[n]
  for (const n of names.filter(n => remote.hidden.has(n))) {
    console.log(`${n} existe chez Vercel mais sa valeur n'est pas relisible. Aucune génération ni rotation autorisée.`)
    if (result[n]) {
      if (!await yes(`Confirmer que la valeur locale de ${n} est bien celle de ce projet Vercel`)) {
        await secretField(result, n, `${n} : valeur ORIGINALE depuis votre coffre`)
      }
    } else await secretField(result, n, `${n} : valeur ORIGINALE depuis votre coffre`)
    if (!result[n]) throw new Error(`${n} : valeur de production nécessaire pour poursuivre, aucune clé générée en remplacement.`)
  }
  remote.confirmedLocal = Object.fromEntries(names.filter(n => remote.hidden.has(n)).map(n => [n, result[n]]))
  return result
}
async function secretField(env, name, label = name) {
  env[name] = await question(`${label} (saisie masquée${env[name] ? ', Entrée = conserver' : ''})`,
    { secret: true, defaultValue: env[name] || '' })
}
async function licenseKey(env) {
  if (env.GF_PRIVATE_KEY) return
  const privateFile = path.join(ROOT, 'keys/private.pem')
  if (fs.existsSync(privateFile)) {
    env.GF_PRIVATE_KEY = fs.readFileSync(privateFile).toString('base64')
    console.log('Clé privée existante importée depuis keys/private.pem ; cohérence vérifiée avant sauvegarde.')
    return
  }
  console.log('\nLicences : la clé privée doit correspondre à la clé publique embarquée.')
  const mode = await select('Source de la clé', [
    { name: 'Importer la clé privée existante (PEM, recommandé)' },
    { name: 'Créer une NOUVELLE autorité (invalide la compatibilité des anciennes licences)' },
  ])
  if (mode.name.startsWith('Importer')) {
    const file = await question('Chemin local du fichier PEM (pas son contenu)')
    try { env.GF_PRIVATE_KEY = fs.readFileSync(path.resolve(ROOT, file)).toString('base64') }
    catch { throw new Error('Fichier de clé privée illisible.') }
  } else {
    console.log('Cette opération modifie les ancrages PUBLICS du code. Les clients déjà installés et garagesite3 ne sont PAS mis à jour par cet outil.')
    if (await question('Pour confirmer une nouvelle autorité, saisir NOUVELLE-AUTORITE') !== 'NOUVELLE-AUTORITE') throw new Error('Création de clé annulée.')
    if (fs.existsSync(privateFile) || fs.existsSync(path.join(ROOT, 'keys/public.pem'))) throw new Error('Des clés existent déjà : aucune rotation automatique autorisée.')
    const pair = crypto.generateKeyPairSync('ec', { namedCurve: 'prime256v1',
      privateKeyEncoding: { type: 'pkcs8', format: 'pem' }, publicKeyEncoding: { type: 'spki', format: 'pem' } })
    core.writePrivate(privateFile, pair.privateKey)
    core.writePrivate(path.join(ROOT, 'keys/public.pem'), pair.publicKey)
    await execute([path.join(ROOT, 'scripts/sync-public-key.mjs')], { label: 'Synchronisation des ancrages publics' })
    env.GF_PRIVATE_KEY = Buffer.from(pair.privateKey).toString('base64')
    console.log('Nouvelle paire créée et ancrages publics synchronisés. Vérifiez le diff et mettez garagesite3 à jour avant publication.')
  }
}
async function advanced(env, names) {
  console.log('\nRéglages avancés : nom exact de variable, Entrée pour terminer. Valeur existante conservée sur Entrée ; « SUPPRIMER » pour la retirer.')
  console.log('Saisir GENERER comme valeur d’un secret symétrique pour une génération explicite sur confirmation. Jamais pour récupérer une clé perdue.')
  console.log('Variables de ce profil :\n' + names.join(', '))
  for (;;) {
    const name = await question('Variable à configurer')
    if (!name) return
    if (!names.includes(name)) { console.log('Variable inconnue ou non applicable à ce profil.'); continue }
    if (core.isSecret(name) && env[name]) {
      console.log('Changer une clé peut invalider les données ou les jetons. Pour une rotation SMTP, suivre la procédure dédiée.')
      if (!await yes(`Modifier explicitement ${name}`)) continue
    }
    const value = await question(`Valeur de ${name}`, { secret: core.isSecret(name), defaultValue: env[name] || '' })
    if (value === 'SUPPRIMER') delete env[name]
    else if (value === 'GENERER' && (core.GENERATED[name] || name === 'GF_EINVOICE_CREDENTIALS_KEY')) {
      console.log('Une nouvelle clé rend les anciennes données/jetons incompatibles. Pour la facturation électronique, uniquement sur une première configuration sans identifiants chiffrés.')
      if (await yes(`Générer explicitement une nouvelle valeur pour ${name}`)) {
        env[name] = crypto.randomBytes(32).toString(core.GENERATED[name] || 'base64')
        console.log(`${name} : générée, valeur masquée.`)
      }
    } else env[name] = value
  }
}
function childEnv(env, vercel) {
  const result = { ...process.env }
  // Ensure the selected profile wins over the shell and Prisma's .env loader.
  for (const n of allNames) result[n] = env[n] || ''
  result.ELECTRON = ''
  result.NODE_ENV = 'production'
  result.VERCEL = vercel ? '1' : ''
  return result
}
async function syncVercel(env, names, expectedRemote) {
  // Re-read immediately before applying. Refuse concurrent changes; do not overwrite/rotate anything.
  const remote = await pullVercel()
  for (const n of names.filter(n => expectedRemote.hidden.has(n))) {
    if (env[n] !== expectedRemote.confirmedLocal[n]) throw new Error(`Vercel : ${n} est non relisible et a été modifiée localement. Aucune synchronisation ni rotation implicite autorisée.`)
  }
  for (const n of names) {
    if (remote.stamps[n] !== expectedRemote.stamps[n] ||
      (remote.values[n] || '') !== (expectedRemote.values[n] || '')) {
      throw new Error(`Vercel : ${n} a changé depuis la lecture initiale. Synchronisation arrêtée, relancez config.`)
    }
  }
  const plan = core.syncPlan(env, remote.values, names.filter(n => !remote.hidden.has(n)))
  if (plan.conflicts.length) throw new Error(`Vercel : conflit sur ${plan.conflicts.join(', ')}. Aucune valeur existante écrasée ; modification manuelle nécessaire.`)
  const additions = plan.additions.filter(n => !remote.present.has(n))
  if (!additions.length) { console.log('Vercel : variables déjà présentes (valeurs sensibles non comparables).'); return true }
  console.log(`Vercel production — ajouts uniquement : ${additions.join(', ')}.`)
  if (!await yes('Ajouter ces variables au projet Vercel sélectionné')) return false
  // No --force / remove: even a concurrent creation is a failure, not an overwrite.
  for (const name of additions) {
    await tool('vercel', ['env', 'add', name, 'production', core.isSecret(name) ? '--sensitive' : '--no-sensitive', '--yes'],
      { input: env[name], label: `Vercel env add ${name}` })
    console.log(`  ${name} : ajoutée (masquée).`)
  }
  const actual = await pullVercel()
  for (const name of additions) {
    if (!actual.present.has(name) || (!actual.hidden.has(name) && actual.values[name] !== env[name])) {
      throw new Error(`Vercel : vérification de ${name} échouée.`)
    }
  }
  console.log('Présence des ajouts vérifiée. Les valeurs Sensitive ne sont pas relisibles : leur contenu ne peut pas être vérifié.')
  return true
}
async function main() {
  const accepted = new Set(['--help', '--check', '--profile', '--vercel'])
  for (let i = 0; i < args.length; i++) {
    if (!accepted.has(args[i])) throw new Error('Option inconnue. Utilisez node config --help.')
    if (args[i] === '--profile') { if (!PROFILES.includes(args[++i])) throw new Error('Profil attendu : desktop | pwa | licences.') }
  }
  if (args.includes('--help')) return help()
  let profile = args.includes('--profile') ? args[args.indexOf('--profile') + 1] : null
  if (!profile && args.includes('--check')) throw new Error('--check nécessite --profile.')
  if (!profile) profile = (await select('Usage à configurer', [
    { id: 'desktop', name: 'Electron / développement SQLite local' },
    { id: 'pwa', name: 'PWA / PostgreSQL (Neon ou autre)' },
    { id: 'licences', name: 'PWA + serveur de licences / control-plane' },
  ])).id
  const names = core.namesForProfile(allNames, profile)
  const envFile = path.join(ROOT, profile === 'desktop' ? '.env' : '.env.server.local')
  let env = core.readEnv(envFile)
  let vercel = args.includes('--vercel')
  if (args.includes('--check')) {
    const errors = core.validate(env, profile, { vercel, publicPem: core.embeddedLicenseKey(ROOT) })
    for (const error of errors) console.error(error)
    if (errors.length) { process.exitCode = 1; return }
    console.log(`Profil ${profile} : configuration locale valide (aucun test de connectivité effectué).`)
    return
  }
  console.log(`\nGarageFlow config — profil ${profile}. Secrets masqués ; aucune rotation automatique.`)
  console.log('Les connexions externes nécessitent un accès réseau à Neon, Vercel et npm sur votre poste.')
  const excluded = Object.keys(env).filter(n => allNames.includes(n) && !names.includes(n) && env[n])
  if (excluded.length) {
    console.log(`Le fichier existant contient des variables incompatibles avec ce profil : ${excluded.join(', ')}.`)
    if (!await yes('Autoriser explicitement leur retrait du fichier local à la sauvegarde (faire une sauvegarde chiffrée avant)')) throw new Error('Fichier local laissé intact : profil incompatible.')
    for (const n of excluded) delete env[n]
  }
  let remote = null
  if (profile !== 'desktop') {
    vercel = vercel || await yes('Configurer et synchroniser le projet Vercel', true)
    if (vercel) {
      remote = await setupVercel()
      env = await importRemote(env, remote, names)
      console.log('Configuration production récupérée AVANT la génération des secrets manquants.')
    }
    if (!env.DATABASE_URL || !env.DIRECT_URL) {
      if (await yes('Récupérer automatiquement les URLs depuis votre compte Neon', true)) await configureNeon(env)
      else { await secretField(env, 'DATABASE_URL', 'URL PostgreSQL poolée'); await secretField(env, 'DIRECT_URL', 'URL PostgreSQL directe') }
    } else console.log('Connexion PostgreSQL existante conservée.')
    env.NEXTAUTH_URL = await question('URL publique HTTPS de la PWA', { defaultValue: env.NEXTAUTH_URL || '' })
    if (!env.UPSTASH_REDIS_REST_URL || !env.UPSTASH_REDIS_REST_TOKEN) {
      console.log('\nUpstash requis en PWA : créez/connectez Redis via Vercel Marketplace ou console.upstash.com, puis copiez les deux valeurs REST (pas rediss://).')
      console.log('Les identifiants seront saisis uniquement dans ce terminal, pas dans le chat.')
      env.UPSTASH_REDIS_REST_URL = await question('UPSTASH_REDIS_REST_URL (https://)', { defaultValue: env.UPSTASH_REDIS_REST_URL || '' })
      await secretField(env, 'UPSTASH_REDIS_REST_TOKEN')
    }
    if (!vercel && !env.TRUST_PROXY_HEADERS) {
      if (await yes('Le serveur est-il derrière un proxy fiable qui nettoie les en-têtes IP')) env.TRUST_PROXY_HEADERS = '1'
    }
    if (profile === 'licences') await licenseKey(env)
    if (!env.ANTHROPIC_API_KEY && await yes('Configurer une clé Anthropic pour OCR/IA (facultatif)')) await secretField(env, 'ANTHROPIC_API_KEY')
  }
  console.log('Les secrets ABSENTS seront générés individuellement. Si cette base contient déjà des données chiffrées ou des licences, importez les clés d’origine via les réglages avancés avant de sauvegarder.')
  env = core.fillMissing(env, names, profile)
  if (profile !== 'desktop' && env.EINVOICING_ENABLED === 'true' && !env.GF_EINVOICE_CREDENTIALS_KEY) {
    console.log('Facturation électronique déjà activée mais clé absente : importer la clé d’origine si des identifiants existent ; ne PAS la régénérer.')
    await secretField(env, 'GF_EINVOICE_CREDENTIALS_KEY')
  }
  if (await yes('Configurer des variables avancées (limites, SMTP, versions, facturation, etc.)')) await advanced(env, names)
  let errors = core.validate(env, profile, { vercel, publicPem: core.embeddedLicenseKey(ROOT) })
  while (errors.length) {
    console.log('\nConfiguration non valide :\n' + errors.join('\n'))
    if (!await yes('Corriger les variables maintenant', true)) throw new Error('Configuration non sauvegardée : validation échouée.')
    await advanced(env, names)
    errors = core.validate(env, profile, { vercel, publicPem: core.embeddedLicenseKey(ROOT) })
  }
  // Preserve unrelated local variables (integration-specific settings), rather than silently deleting them.
  const outputNames = [...names, ...Object.keys(env).filter(n => !allNames.includes(n))]
  const contents = core.serializeEnv(env, outputNames, profile)
  if (!await yes(`Enregistrer ${path.basename(envFile)} (fichier local ignoré par Git)`, true)) return
  core.writePrivate(envFile, contents)
  console.log(`${path.basename(envFile)} enregistré, permissions privées (0600 sur POSIX). Sous Windows, sécurisez les ACL du dossier utilisateur.`)
  if (profile === 'desktop') {
    if (await yes('Initialiser la base SQLite avec le setup existant', true)) {
      await execute([path.join(ROOT, 'scripts/setup-dev.js')],
        { env: { ...process.env, VERCEL: '', DATABASE_URL: env.DATABASE_URL, NEXTAUTH_SECRET: env.NEXTAUTH_SECRET }, label: 'Initialisation desktop' })
      console.log('Setup SQLite terminé.')
    }
  } else {
    const synced = vercel ? await syncVercel(env, names, remote) : false
    console.log('\nMigrations : modifient la base cible. Sauvegardez une base existante avant de poursuivre.')
    if (await question('Pour appliquer prisma migrate deploy, saisir MIGRER (Entrée = ignorer)') === 'MIGRER') {
      const prisma = path.join(ROOT, 'node_modules/prisma/build/index.js')
      if (!fs.existsSync(prisma)) throw new Error('Prisma absent. Exécutez npm ci puis relancez config ; les valeurs locales ont été conservées.')
      await execute([prisma, 'migrate', 'deploy', '--schema', 'prisma/server/schema.prisma'],
        { env: childEnv(env, vercel), label: 'Migrations PostgreSQL' })
      console.log('Migrations PostgreSQL appliquées avec DIRECT_URL explicite.')
    }
    if (vercel && synced && await question('Pour déployer en production, saisir DEPLOYER (Entrée = ignorer)') === 'DEPLOYER') {
      await tool('vercel', ['deploy', '--prod', '--yes'], { label: 'Déploiement production' })
      console.log('Déploiement accepté par Vercel. Vérifiez ensuite le domaine, les logs et les parcours métier.')
    }
  }
  console.log('\nConfiguration terminée. Aucun secret n’a été committé ni affiché.')
  console.log('GF_UPDATE_SIGNING_KEY reste EXCLUSIVEMENT dans le coffre du serveur de publication garagesite3 ; config ne la génère ni ne l’exporte ici.')
}
main().catch(error => {
  // All errors reaching here are sanitized; never print raw external stdout/stderr or stacks.
  if (error instanceof Error && error.code) console.error('Configuration interrompue : opération locale impossible. Vérifiez les permissions et les fichiers.')
  else console.error(error.message || 'Configuration interrompue.')
  process.exitCode = 1
})
