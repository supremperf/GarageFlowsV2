async function syncVercel(env, names, expectedRemote, { authorized = false, readRemote = pullVercel, runTool = tool } = {}) {
  // Re-read immediately before applying. Refuse concurrent changes; only rotate explicitly planned names.
  const remote = await readRemote()
  for (const n of names.filter(n => expectedRemote.hidden.has(n))) {
    if (env[n] !== expectedRemote.confirmedLocal[n]) throw new Error(`Vercel : ${n} est non relisible et a été modifiée localement. Aucune synchronisation ni rotation implicite autorisée.`)
  }
  for (const n of names) {
    if (remote.stamps[n] !== expectedRemote.stamps[n] ||
      (remote.values[n] || '') !== (expectedRemote.values[n] || '')) {
      throw new Error(`Vercel : ${n} a changé depuis la lecture initiale. Synchronisation arrêtée, relancez config.`)
    }
  }
  const plan = core.syncPlan(env, remote.values, names.filter(n => !remote.hidden.has(n)))
  if (plan.conflicts.length) throw new Error(`Vercel : conflit sur ${plan.conflicts.join(', ')}. Aucune valeur existante écrasée ; modification manuelle nécessaire.`)

  // Deux gestes distincts, jamais mélangés :
  //   • AJOUT  : la variable n’existe pas chez Vercel → on la crée ;
  //   • REMPLACEMENT : la variable existe mais sa valeur n’est pas relisible et
  //     la valeur locale a été générée (ou explicitement admise) pour elle. Un
  //     `env add` ne peut pas modifier une variable existante : il faut la
  //     retirer PUIS la recréer. Ce geste est décidé plus haut, nommément,
  //     jamais « au cas où ».
  const remplacements = [...(expectedRemote.replacements || [])].filter(n => names.includes(n) && remote.present.has(n))
  const additions = plan.additions.filter(n => !remote.present.has(n) && !remplacements.includes(n))
  if (!additions.length && !remplacements.length) {
    console.log('Vercel : toutes les variables sont déjà présentes, aucune valeur relisible modifiée.')
    enregistrerRecus(env, names.filter(n => remote.hidden.has(n)), expectedRemote, remote)
    return true
  }
  if (additions.length) console.log(`Vercel production — ajouts : ${additions.join(', ')}.`)
  if (remplacements.length) {
    console.log(`Vercel production — REMPLACEMENTS : ${remplacements.join(', ')} (valeurs existantes non relisibles).`)
    console.log('Les sessions, appareils enregistrés, jetons et données chiffrés liés à ces clés devront être recréés.')
  }
  if (!authorized && !await yes('Appliquer ces changements au projet Vercel sélectionné')) return false
  for (const name of [...additions, ...remplacements]) {
    const remplacer = remplacements.includes(name)
    for (const commandArgs of auto.planEcritureVercel(name, { sensible: core.isSecret(name), present: remplacer, remplacer })) {
      await runTool('vercel', commandArgs, { input: commandArgs[1] === 'add' ? env[name] : undefined, label: `Vercel env ${commandArgs[1]} ${name}` })
    }
    console.log(`  ${name} : ${remplacer ? 'remplacée' : 'ajoutée'} (masquée).`)
  }
  const actual = await readRemote()
  for (const name of additions) {
    if (!actual.present.has(name) || (!actual.hidden.has(name) && actual.values[name] !== env[name])) {
      throw new Error(`Vercel : vérification de ${name} échouée.`)
    }
  }
  for (const name of remplacements) {
    // Une valeur remplacée change de date : l’horodatage prouve l’écriture,
    // même quand son contenu n’est pas relisible.
    if (!actual.present.has(name) || actual.stamps[name] === remote.stamps[name]) {
      throw new Error(`Vercel : le remplacement de ${name} n’a pas été confirmé (variable absente ou inchangée).`)
    }
  }
  console.log('Présence, horodatages et valeurs relisibles vérifiés après écriture. Aucun contenu secret affiché ; les valeurs encore masquées ne sont pas comparables.')
  enregistrerRecus(env, names.filter(n => actual.hidden.has(n)), expectedRemote, actual)
  return true
}

