  items.forEach((item, i) => console.log(`  ${i + 1}. ${safeLabel(item.name || item.id)}`))
  for (;;) {
    const i = Number(await question(label, { defaultValue: items.length === 1 ? '1' : '' })) - 1
    if (Number.isInteger(i) && items[i]) return items[i]
    console.log('Choisissez un numéro dans la liste.')
  }
}
function npmCli() {
  const candidates = [process.env.npm_execpath,
    path.join(path.dirname(process.execPath), 'node_modules/npm/bin/npm-cli.js'),
    path.join(path.dirname(process.execPath), '../lib/node_modules/npm/bin/npm-cli.js'),
    '/usr/share/nodejs/npm/bin/npm-cli.js']
  const found = candidates.find(p => p && /npm-cli\.js$/.test(p) && fs.existsSync(p))
  if (!found) throw new Error('npm introuvable. Lancez avec npm run config (Node 22 + npm requis).')
  return found
}
function execute(commandArgs, { interactive = false, input, env = process.env, label = 'Commande', captureVercelApiFailure = false } = {}) {
  return new Promise((resolve, reject) => {
    // No shell: project IDs, file paths and secrets can never become shell commands.
    const child = spawn(process.execPath, commandArgs, { cwd: ROOT, env,
      stdio: interactive ? 'inherit' : ['pipe', 'pipe', 'pipe'] })
    let stdout = '', stderr = ''
    if (!interactive) {
      child.stdout.setEncoding('utf8')
      child.stdout.on('data', chunk => { stdout += chunk })
      // Never forward provider output. For Storage reads only, extract fixed
      // diagnostic labels on failure; raw stderr is bounded and discarded.
      if (captureVercelApiFailure) {
        child.stderr.setEncoding('utf8')
        child.stderr.on('data', chunk => { stderr = (stderr + chunk).slice(-65536) })
      } else child.stderr.resume()
      child.stdin.on('error', () => {})
      child.stdin.end(input === undefined ? undefined : input)
    }
    child.once('error', () => reject(new Error(`${label} : lancement impossible.`)))
    child.once('close', code => {
      if (code === 0) return resolve(stdout)
      const error = new Error(`${label} : échec. Aucune validation revendiquée ; vérifiez votre connexion et vos droits, puis relancez.`)
      error.exitCode = code // Preserve status without exposing provider output or credentials.
      if (captureVercelApiFailure) error.vercelApi = require('./scripts/lib/config-vercel-api.cjs').commandFailure(stdout, stderr, code)
      if (code === 2 && commandArgs.includes('migrate') && commandArgs.includes('diff')) error.sqlDiffSummary = summarizeSqlDiff(stdout)
      reject(error)
    })
  })
}
function tool(name, commandArgs, options = {}) {
  return execute([npmCli(), 'exec', '--yes', `--package=${TOOLS[name]}`, '--', name, ...commandArgs],
    { ...options, label: options.label || name })
}
async function neonList(commandArgs, key, runTool = tool) {
  const output = await runTool('neonctl', [...commandArgs, '--output', 'json'])
  try {
    const data = JSON.parse(output)
    const list = Array.isArray(data) ? data : data[key]
    if (!Array.isArray(list)) throw new Error()
    return list
  } catch { throw new Error('Neon : format JSON inattendu, aucune valeur importée.') }
}
async function configureNeon(env, { auto = false, allowCreate = auto, api = { tool, select, yes } } = {}) {
  const list = (args, key) => neonList(args, key, api.tool)
  console.log('\nConnexion Neon via le CLI officiel. Aucun jeton Neon stocké par config.')
  let orgs
  try { orgs = await list(['orgs', 'list'], 'organizations') }
  catch {
    await api.tool('neonctl', ['auth'], { interactive: true })
    orgs = await list(['orgs', 'list'], 'organizations')
  }
  const choose = async (label, list) => auto && list.length === 1 ? list[0] : api.select(label, list)
  const org = orgs.length ? await choose('Organisation Neon', orgs) : null
  const orgArgs = org ? ['--org-id', org.id] : []
  let projects = await list(['projects', 'list', ...orgArgs], 'projects')
  if (!projects.length && allowCreate) {
    console.log('Aucun projet Neon : création possible dans le compte autorisé (région Europe). Vérifier quotas et conditions fournisseur.')
    if (!await api.yes('Autoriser la création du projet PostgreSQL GarageFlows')) throw new Error('Projet Neon absent et création non autorisée.')
    await api.tool('neonctl', ['projects', 'create', '--name', 'garageflows', '--region-id', 'aws-eu-central-1', '--database', 'garageflow', '--role', 'garageflow_owner', ...orgArgs])
    projects = await list(['projects', 'list', ...orgArgs], 'projects')
  }
  if (!projects.length) throw new Error('Aucun projet Neon accessible dans cette organisation. Vérifiez le compte/la cible : récupération sans création de base.')
  const project = await choose('Projet Neon', projects)
  const branches = await list(['branches', 'list', '--project-id', project.id], 'branches')
  const branch = await choose('Branche Neon (choisir la base cible)', branches)
  const scope = ['--project-id', project.id, '--branch', branch.id]
  const database = await choose('Base Neon', await list(['databases', 'list', ...scope], 'databases'))
  const role = await choose('Rôle PostgreSQL', await list(['roles', 'list', ...scope], 'roles'))
  const connectionArgs = ['connection-string', branch.id, '--project-id', project.id,
    '--database-name', database.name, '--role-name', role.name]
  // Neon returns the actual endpoints; no guessing by removing '-pooler'.
  const pooled = (await api.tool('neonctl', [...connectionArgs, '--pooled'])).trim()
  const direct = (await api.tool('neonctl', connectionArgs)).trim()
  for (const [name, candidateUrl] of [['DATABASE_URL', pooled], ['DIRECT_URL', direct]]) {
    if (!env[name]) continue
    try {
      const old = new URL(env[name]), candidate = new URL(candidateUrl)
      if (old.hostname !== candidate.hostname || old.pathname !== candidate.pathname || old.username !== candidate.username) throw new Error()
    } catch { throw new Error(`Neon : sélection différente de ${name} existante. Aucune URL remplacée ; vérifier projet/branche/base/rôle.`) }
  }
  env.DATABASE_URL ||= pooled
  env.DIRECT_URL ||= direct
  console.log('DATABASE_URL poolée et DIRECT_URL directe récupérées (valeurs masquées).')
}
async function pullVercel({ runTool = tool, root = ROOT } = {}) {
  fs.mkdirSync(path.join(root, 'GarageFlow-configuration'), { recursive: true, mode: 0o700 })
  const dir = fs.mkdtempSync(path.join(root, 'GarageFlow-configuration/pull-'))
  fs.chmodSync(dir, 0o700)
  const file = path.join(dir, '.env.production.local')
  try {
    const raw = await runTool('vercel', ['env', 'ls', 'production', '--format=json'])
    let records
    try {
      const inventory = JSON.parse(raw)
      if (inventory.pagination?.next) throw new Error()
      records = inventory.envs
      if (!Array.isArray(records)) throw new Error()
    } catch { throw new Error('Vercel : métadonnées JSON invalides, synchronisation refusée.') }
    await runTool('vercel', ['env', 'pull', file, '--environment=production', '--yes'])
    fs.chmodSync(file, 0o600)
    const values = core.readEnv(file)
    return require('./scripts/lib/config-vercel-env.cjs').fromPull(records, values)
  } finally { fs.rmSync(dir, { recursive: true, force: true }) }
}
async function refreshVercelAuth() {
  if (!process.stdin.isTTY || !process.stdout.isTTY) throw new Error('Authentification Vercel récente requise : relancer dans un terminal interactif.')
  await tool('vercel', ['login'], { interactive: true })
}
async function setupVercel({ authorized = false } = {}) {
  console.log('\nVercel : connexion puis sélection EXPLICITE du projet cible (production uniquement).')
  try { await tool('vercel', ['whoami']) }
  catch { await tool('vercel', ['login'], { interactive: true }) }
  const linkFile = path.join(ROOT, '.vercel/project.json')
  if (fs.existsSync(linkFile)) {
    const linked = JSON.parse(fs.readFileSync(linkFile, 'utf8'))
    if (!authorized && !await yes(`Confirmer le projet Vercel déjà lié ${safeLabel(linked.projectName || linked.projectId)} (équipe ${safeLabel(linked.orgId)})`)) throw new Error('Cible Vercel non confirmée. Relier explicitement le projet correct avant de poursuivre.')
  } else await tool('vercel', ['link'], { interactive: true })
  const project = JSON.parse(fs.readFileSync(path.join(ROOT, '.vercel/project.json'), 'utf8'))
  console.log(`Cible Vercel : ${safeLabel(project.projectName || project.projectId)} (équipe ${safeLabel(project.orgId)}).`)
  fs.mkdirSync(path.join(ROOT, 'GarageFlow-configuration'), { recursive: true, mode: 0o700 })
  return pullVercel()
}
/** Résout les valeurs de production sans confondre « illisible » et « absente ». */
async function importRemote(local, remote, names, { rotationAutorisee = false, deferGenerated = false } = {}) {
  const conflicts = core.syncPlan(local, remote.values, names).conflicts
  if (conflicts.length) {
    console.log(`Valeurs locales différentes de Vercel : ${conflicts.join(', ')}.`)
    if (!await yes('Utiliser les valeurs Vercel pour ce profil serveur (sans modifier Vercel)', true)) {
      throw new Error('Conflit non résolu. Rien synchronisé. Sauvegardez votre configuration avant de relancer.')
    }
  }
  const result = { ...local }
  for (const n of names) if (remote.values[n]) result[n] = remote.values[n]
  const cachees = names.filter(n => remote.hidden.has(n))
  const generables = Object.keys(core.GENERATED)
  const differees = deferGenerated ? cachees.filter(n => !result[n] && generables.includes(n)) : []
  const aResoudre = cachees.filter(n => !differees.includes(n))
  remote.deferredGenerated = new Set(differees)
  const recus = auto.lireRecus(ROOT)

  // Une URL vient du fournisseur réel, jamais du générateur de secrets.
  const fournisseurs = {}
  if (aResoudre.some(n => ['DATABASE_URL', 'DIRECT_URL'].includes(n) && !result[n])) {
    try {
      const fourni = { ...result }
      await configureNeon(fourni, { auto: true, allowCreate: false })
      for (const n of ['DATABASE_URL', 'DIRECT_URL']) if (!result[n] && fourni[n]) fournisseurs[n] = fourni[n]
    } catch {
      console.log('Neon : récupération automatique indisponible ; fournissez les URLs réelles du projet existant. Aucun détail sensible affiché.')
    }
  }
  const aGenerer = aResoudre.filter(n => !result[n] && generables.includes(n))
  let autorise = rotationAutorisee === true
  if (aGenerer.length && !autorise) {
    console.log(`Secrets déjà présents sur Vercel mais introuvables localement : ${aGenerer.join(', ')}.`)
    console.log('Les remplacer invalide les sessions, jetons ou données qui dépendent des anciennes clés. Un nouveau PC ne prouve pas que la production est vide.')
    autorise = await yes('Générer ces secrets et les REMPLACER sur le projet Vercel sélectionné', false)
  }
  const resolution = auto.resoudreValeursCachees({
    noms: aResoudre, local: result, recus, generables, fournisseurs,
    rotationAutorisee: autorise,
    generer: nom => crypto.randomBytes(32).toString(core.GENERATED[nom] || 'base64'),
  })
  Object.assign(result, resolution.valeurs)
  const connues = [...resolution.locales, ...resolution.fournies]
  const verdict = auto.verifierRecus(recus, Object.fromEntries(connues.map(n => [n, result[n]])), projectSlug(), remote.stamps)
  const remplacements = new Set(resolution.remplacements)
  if (verdict.divergents.length) {
    console.log(`Valeurs locales différentes du dernier envoi : ${verdict.divergents.join(', ')}.`)
    if (!await yes('Autoriser explicitement leur REMPLACEMENT chez Vercel (anciennes données/jetons potentiellement incompatibles)', false)) {
      throw new Error('Écart non tranché : aucune synchronisation autorisée.')
    }
    for (const n of verdict.divergents) remplacements.add(n)
  }
  if (verdict.inconnus.length) {
    console.log(`Valeurs non vérifiables automatiquement pour ce projet : ${verdict.inconnus.join(', ')}.`)
    if (!await yes('Confirmer que ces valeurs sont les ORIGINALES de ce projet Vercel (aucun remplacement)', false)) {
      throw new Error('Valeurs de production non confirmées : aucun reçu de synchronisation créé.')
    }
  }
  if (resolution.generees.length) console.log(`${resolution.generees.join(', ')} : générées automatiquement (256 bits, masquées) ; remplacement autorisé.`)
  if (resolution.aFournir.length) {
    console.log(`Valeurs originales encore nécessaires : ${resolution.aFournir.join(', ')}. Les identifiants de services ne peuvent pas être inventés.`)
    for (const n of resolution.aFournir) await secretField(result, n, `${n} : valeur ORIGINALE du projet`)
    if (resolution.aFournir.some(n => !result[n])) throw new Error('Valeurs originales manquantes : rien synchronisé.')
  }
  remote.generatedHere = new Set([...(remote.generatedHere || []), ...resolution.generees])
  remote.replacements = new Set([...(remote.replacements || []), ...remplacements])
  remote.fourniesIci = new Set([...(remote.fourniesIci || []), ...resolution.fournies])
  remote.confirmedLocal = { ...remote.confirmedLocal, ...Object.fromEntries(aResoudre.map(n => [n, result[n]])) }
  return result
}

async function secretField(env, name, label = name) {
  env[name] = await question(`${label} (saisie ${visibleSecretInput ? 'visible' : 'masquée'}${env[name] ? ', Entrée = conserver' : ''})`,
    { secret: true, defaultValue: env[name] || '' })
}
const privateKeyPassphrases = new Map()
async function licensePassphrase(file) {
  if (!privateKeyPassphrases.has(file)) {
    privateKeyPassphrases.set(file, await question('Passphrase de la clé P-256 chiffrée (en mémoire uniquement)', { secret: true }))
  }
  return privateKeyPassphrases.get(file)
}
async function readLicensePem(file) {
  let pem
  try { pem = fs.readFileSync(file, 'utf8') } catch { throw new Error('Fichier de clé privée illisible.') }
  const encrypted = /ENCRYPTED PRIVATE KEY|Proc-Type:\s*4,ENCRYPTED/.test(pem)
  try {
    const key = crypto.createPrivateKey(encrypted ? { key: pem, passphrase: await licensePassphrase(file) } : pem)
    if (key.asymmetricKeyType !== 'ec' || key.asymmetricKeyDetails.namedCurve !== 'prime256v1') throw new Error()
    return key.export({ type: 'pkcs8', format: 'pem' }).toString()
  } catch { throw new Error('Clé de licence illisible, passphrase incorrecte ou courbe non P-256. Aucun contenu affiché.') }
}
async function licenseKey(env, { root = ROOT, choose = select, prompt = question, readPem = readLicensePem, run = execute, autoCreate = false } = {}) {
  if (env.GF_PRIVATE_KEY) return
  const keys = require('./scripts/config-keys.cjs')
  const services = require('./scripts/config-services.cjs')
  const privateFile = path.join(root, 'keys/private.pem')
  const publicFile = path.join(root, 'keys/public.pem')
  const sync = async () => run([path.join(root, 'scripts/sync-public-key.mjs')], { label: 'Synchronisation des ancrages publics' })
  const importFile = async file => {
    let stat
    try { stat = fs.statSync(file) } catch { throw new Error('Clé privée introuvable/illisible au chemin indiqué. Chemin proposé : keys/private.pem. Aucun remplacement de clé automatique.') }
    if (!stat.isFile()) throw new Error('Clé privée : fichier PEM requis, pas un dossier.')
    const pem = await readPem(file)
    const state = keys.readState(root)
    // Resume a first-install sync only for the exact key previously generated here.
    // An unrelated/missing original never gets replaced to satisfy the embedded anchor.
    if (autoCreate && state?.autoGenerated) {
      if (!keys.matchesIssuer(state, pem)) throw new Error('Clé privée différente du reçu de création ; aucune rotation automatique.')
      if (fs.existsSync(publicFile) && services.publicFingerprint(fs.readFileSync(publicFile)) !== state.licensePublicFingerprint) throw new Error('Clé publique locale divergente, aucun remplacement automatique.')
      if (!fs.existsSync(publicFile)) core.writePrivate(publicFile, crypto.createPublicKey(pem).export({ type: 'spki', format: 'pem' }).toString(), { exclusive: true })
      // Re-run the idempotent sync for ALL anchors, even if the Next anchor was
      // already written before a previous interruption (Electron/test anchors may lag).
      await sync()
    }
    const value = Buffer.from(pem).toString('base64')
    if (!core.licenseKeyMatches(value, core.embeddedLicenseKey(root))) throw new Error('Clé privée différente de la clé publique embarquée : aucun import ni changement d’autorité automatique.')
    env.GF_PRIVATE_KEY = value
  }
  if (fs.existsSync(privateFile)) {
    await importFile(privateFile)
    console.log('Clé privée détectée et importée automatiquement depuis keys/private.pem. Identité publique vérifiée ; fichier original conservé.')
    return
  }
  const create = async automatic => {
    if (fs.existsSync(privateFile) || fs.existsSync(publicFile) || keys.readState(root) ||
        (automatic && fs.existsSync(path.join(root, 'keys/server_config.json')))) {
      throw new Error('Autorité locale existante ou création interrompue : clé privée ORIGINALE nécessaire, aucune rotation automatique autorisée.')
    }
    const pair = crypto.generateKeyPairSync('ec', { namedCurve: 'prime256v1',
      privateKeyEncoding: { type: 'pkcs8', format: 'pem' }, publicKeyEncoding: { type: 'spki', format: 'pem' } })
    core.writePrivate(privateFile, pair.privateKey, { exclusive: true })
    core.writePrivate(publicFile, pair.publicKey, { exclusive: true })
    keys.recordCreation(root, pair.publicKey, automatic)
    await sync()
    if (!core.licenseKeyMatches(Buffer.from(pair.privateKey).toString('base64'), core.embeddedLicenseKey(root))) throw new Error('Nouvelle autorité sauvegardée mais ancrages non synchronisés ; relancer config, sans régénérer les clés.')
    env.GF_PRIVATE_KEY = Buffer.from(pair.privateKey).toString('base64')
    console.log('Première paire P-256 générée et enregistrée automatiquement ; ancrages publics synchronisés. Aucune clé affichée. Les anciens clients et garagesite3 ne sont pas modifiés : reconstruire/distribuer les nouveaux ancrages avant utilisation.')
  }
  if (autoCreate) return create(true)
