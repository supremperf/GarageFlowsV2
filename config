async function question(label, { secret = false, defaultValue = '' } = {}) {
  if (!process.stdin.isTTY) throw new Error('Un terminal interactif est requis (ou utilisez --check / --help).')
  let hideDefault = secret
  try { const url = new URL(defaultValue); hideDefault ||= !!url.username || !!url.password } catch { /* Not a URL. */ }
  const prompt = `${label}${defaultValue ? ` [${hideDefault ? 'déjà configuré' : safeLabel(defaultValue)}]` : ''} : `
  // Let readline own visible prompts: an empty question redraws the line and
  // erases a separately printed label, notably in Windows Command Prompt.
  if (secret) process.stdout.write(prompt)
  // A terminal readline with a muted output enables raw input without echoing passwords.
  const output = secret ? new Writable({ write(_chunk, _encoding, done) { done() } }) : process.stdout
  const rl = readline.createInterface({ input: process.stdin, output, terminal: true })
  try {
    return await new Promise((resolve, reject) => {
      rl.once('SIGINT', () => reject(new Error('Configuration annulée.')))
      rl.question(secret ? '' : prompt, value => resolve((secret ? value : value.trim()) || defaultValue))
    })
  } finally { rl.close(); if (secret) process.stdout.write('\n') }
}
async function yes(label, defaultYes = false) {
  while (true) {
    const answer = await question(`${label} (oui/non)`, { defaultValue: defaultYes ? 'oui' : 'non' })
    if (/^(o|oui|y|yes)$/i.test(answer)) return true
    if (/^(n|non|no)$/i.test(answer)) return false
    console.log('Réponse attendue : oui ou non. Aucun autre texte ne vaut autorisation.')
  }
}
async function select(label, items) {
  if (!items.length) throw new Error(`${label} : aucun résultat. Créez la ressource dans le tableau de bord du fournisseur, puis relancez config.`)
  items.forEach((item, i) => console.log(`  ${i + 1}. ${safeLabel(item.name || item.id)}`))
  for (;;) {
    const i = Number(await question(label, { defaultValue: items.length === 1 ? '1' : '' })) - 1
    if (Number.isInteger(i) && items[i]) return items[i]
    console.log('Choisissez un numéro dans la liste.')
  }
}
function npmCli() {
  const candidates = [process.env.npm_execpath,
    path.join(path.dirname(process.execPath), 'node_modules/npm/bin/npm-cli.js'),
    path.join(path.dirname(process.execPath), '../lib/node_modules/npm/bin/npm-cli.js'),
    '/usr/share/nodejs/npm/bin/npm-cli.js']
  const found = candidates.find(p => p && /npm-cli\.js$/.test(p) && fs.existsSync(p))
  if (!found) throw new Error('npm introuvable. Lancez avec npm run config (Node 22 + npm requis).')
  return found
}
function execute(commandArgs, { interactive = false, input, env = process.env, label = 'Commande' } = {}) {
  return new Promise((resolve, reject) => {
    // No shell: project IDs, file paths and secrets can never become shell commands.
    const child = spawn(process.execPath, commandArgs, { cwd: ROOT, env,
      stdio: interactive ? 'inherit' : ['pipe', 'pipe', 'pipe'] })
    let stdout = ''
    if (!interactive) {
      child.stdout.setEncoding('utf8')
      child.stdout.on('data', chunk => { stdout += chunk })
      child.stderr.resume() // Never forward stderr: external tools may include credentials in errors.
      child.stdin.on('error', () => {})
      child.stdin.end(input === undefined ? undefined : input)
    }
    child.once('error', () => reject(new Error(`${label} : lancement impossible.`)))
    child.once('close', code => {
      if (code === 0) return resolve(stdout)
      const error = new Error(`${label} : échec. Aucune validation revendiquée ; vérifiez votre connexion et vos droits, puis relancez.`)
      error.exitCode = code // Preserve status without exposing provider output or credentials.
      if (code === 2 && commandArgs.includes('migrate') && commandArgs.includes('diff')) error.sqlDiffSummary = summarizeSqlDiff(stdout)
      reject(error)
    })
  })
}
function tool(name, commandArgs, options = {}) {
  return execute([npmCli(), 'exec', '--yes', `--package=${TOOLS[name]}`, '--', name, ...commandArgs],
    { ...options, label: options.label || name })
}
async function neonList(commandArgs, key, runTool = tool) {
  const output = await runTool('neonctl', [...commandArgs, '--output', 'json'])
  try {
    const data = JSON.parse(output)
    const list = Array.isArray(data) ? data : data[key]
    if (!Array.isArray(list)) throw new Error()
    return list
  } catch { throw new Error('Neon : format JSON inattendu, aucune valeur importée.') }
}
async function configureNeon(env, { auto = false, allowCreate = auto, api = { tool, select, yes } } = {}) {
  const list = (args, key) => neonList(args, key, api.tool)
  console.log('\nConnexion Neon via le CLI officiel. Aucun jeton Neon stocké par config.')
  let orgs
  try { orgs = await list(['orgs', 'list'], 'organizations') }
  catch {
    await api.tool('neonctl', ['auth'], { interactive: true })
    orgs = await list(['orgs', 'list'], 'organizations')
  }
  const choose = async (label, list) => auto && list.length === 1 ? list[0] : api.select(label, list)
  const org = orgs.length ? await choose('Organisation Neon', orgs) : null
  const orgArgs = org ? ['--org-id', org.id] : []
  let projects = await list(['projects', 'list', ...orgArgs], 'projects')
  if (!projects.length && allowCreate) {
    console.log('Aucun projet Neon : création possible dans le compte autorisé (région Europe). Vérifier quotas et conditions fournisseur.')
    if (!await api.yes('Autoriser la création du projet PostgreSQL GarageFlows')) throw new Error('Projet Neon absent et création non autorisée.')
    await api.tool('neonctl', ['projects', 'create', '--name', 'garageflows', '--region-id', 'aws-eu-central-1', '--database', 'garageflow', '--role', 'garageflow_owner', ...orgArgs])
    projects = await list(['projects', 'list', ...orgArgs], 'projects')
  }
  if (!projects.length) throw new Error('Aucun projet Neon accessible dans cette organisation. Vérifiez le compte/la cible : récupération sans création de base.')
  const project = await choose('Projet Neon', projects)
  const branches = await list(['branches', 'list', '--project-id', project.id], 'branches')
  const branch = await choose('Branche Neon (choisir la base cible)', branches)
  const scope = ['--project-id', project.id, '--branch', branch.id]
  const database = await choose('Base Neon', await list(['databases', 'list', ...scope], 'databases'))
  const role = await choose('Rôle PostgreSQL', await list(['roles', 'list', ...scope], 'roles'))
  const connectionArgs = ['connection-string', branch.id, '--project-id', project.id,
    '--database-name', database.name, '--role-name', role.name]
  // Neon returns the actual endpoints; no guessing by removing '-pooler'.
  const pooled = (await api.tool('neonctl', [...connectionArgs, '--pooled'])).trim()
  const direct = (await api.tool('neonctl', connectionArgs)).trim()
  for (const [name, candidateUrl] of [['DATABASE_URL', pooled], ['DIRECT_URL', direct]]) {
    if (!env[name]) continue
    try {
      const old = new URL(env[name]), candidate = new URL(candidateUrl)
      if (old.hostname !== candidate.hostname || old.pathname !== candidate.pathname || old.username !== candidate.username) throw new Error()
    } catch { throw new Error(`Neon : sélection différente de ${name} existante. Aucune URL remplacée ; vérifier projet/branche/base/rôle.`) }
  }
  env.DATABASE_URL ||= pooled
  env.DIRECT_URL ||= direct
  console.log('DATABASE_URL poolée et DIRECT_URL directe récupérées (valeurs masquées).')
}
async function pullVercel() {
  fs.mkdirSync(path.join(ROOT, 'GarageFlow-configuration'), { recursive: true, mode: 0o700 })
  const dir = fs.mkdtempSync(path.join(ROOT, 'GarageFlow-configuration/pull-'))
  fs.chmodSync(dir, 0o700)
  const file = path.join(dir, '.env.production.local')
  try {
    const raw = await tool('vercel', ['env', 'ls', 'production', '--format=json'])
    let records
    try {
      records = JSON.parse(raw).envs
      if (!Array.isArray(records)) throw new Error()
    } catch { throw new Error('Vercel : métadonnées JSON invalides, synchronisation refusée.') }
    await tool('vercel', ['env', 'pull', file, '--environment=production', '--yes'])
    fs.chmodSync(file, 0o600)
    const values = core.readEnv(file)
    const hidden = new Set()
    const present = new Set()
    const stamps = {}
    for (const r of records) {
      present.add(r.key)
      stamps[r.key] = JSON.stringify([r.updatedAt, r.createdAt, r.type, r.visibility, r.configurationId])
      // Sensitive values cannot be retrieved: never mistake a placeholder for an absent secret.
      if (r.type === 'sensitive' || r.visibility === 'secret' || !values[r.key]) {
        hidden.add(r.key)
        delete values[r.key]
      }
    }
    return { values, hidden, present, stamps }
  } finally { fs.rmSync(dir, { recursive: true, force: true }) }
}
async function setupVercel() {
  console.log('\nVercel : connexion puis sélection EXPLICITE du projet cible (production uniquement).')
  try { await tool('vercel', ['whoami']) }
  catch { await tool('vercel', ['login'], { interactive: true }) }
  const linkFile = path.join(ROOT, '.vercel/project.json')
  if (fs.existsSync(linkFile)) {
    const linked = JSON.parse(fs.readFileSync(linkFile, 'utf8'))
    if (!await yes(`Confirmer le projet Vercel déjà lié ${safeLabel(linked.projectName || linked.projectId)} (équipe ${safeLabel(linked.orgId)})`)) throw new Error('Cible Vercel non confirmée. Relier explicitement le projet correct avant de poursuivre.')
  } else await tool('vercel', ['link'], { interactive: true })
  const project = JSON.parse(fs.readFileSync(path.join(ROOT, '.vercel/project.json'), 'utf8'))
  console.log(`Cible Vercel : ${safeLabel(project.projectName || project.projectId)} (équipe ${safeLabel(project.orgId)}).`)
  fs.mkdirSync(path.join(ROOT, 'GarageFlow-configuration'), { recursive: true, mode: 0o700 })
  return pullVercel()
}
async function importRemote(local, remote, names) {
  const conflicts = core.syncPlan(local, remote.values, names).conflicts
  if (conflicts.length) {
    console.log(`Valeurs locales différentes de Vercel : ${conflicts.join(', ')}.`)
    console.log('Conserver les clés de production évite de casser sessions, données chiffrées et licences.')
    if (!await yes('Utiliser les valeurs Vercel pour ce profil serveur (sans modifier Vercel)', true)) {
      throw new Error('Conflit non résolu. Rien synchronisé. Sauvegardez votre configuration avant de relancer.')
    }
  }
  const result = { ...local }
  for (const n of names) if (remote.values[n]) result[n] = remote.values[n]
  for (const n of names.filter(n => remote.hidden.has(n))) {
    console.log(`${n} existe chez Vercel mais sa valeur n'est pas relisible. Aucune génération ni rotation autorisée.`)
    if (result[n]) {
      if (!await yes(`Confirmer que la valeur locale de ${n} est bien celle de ce projet Vercel`)) {
        await secretField(result, n, `${n} : valeur ORIGINALE depuis votre coffre`)
      }
    } else await secretField(result, n, `${n} : valeur ORIGINALE depuis votre coffre`)
    if (!result[n]) throw new Error(`${n} : valeur de production nécessaire pour poursuivre, aucune clé générée en remplacement.`)
  }
  remote.confirmedLocal = Object.fromEntries(names.filter(n => remote.hidden.has(n)).map(n => [n, result[n]]))
  return result
}
async function secretField(env, name, label = name) {
  env[name] = await question(`${label} (saisie masquée${env[name] ? ', Entrée = conserver' : ''})`,
    { secret: true, defaultValue: env[name] || '' })
}
const privateKeyPassphrases = new Map()
async function licensePassphrase(file) {
  if (!privateKeyPassphrases.has(file)) {
    privateKeyPassphrases.set(file, await question('Passphrase de la clé P-256 chiffrée (en mémoire uniquement)', { secret: true }))
  }
  return privateKeyPassphrases.get(file)
}
async function readLicensePem(file) {
  let pem
  try { pem = fs.readFileSync(file, 'utf8') } catch { throw new Error('Fichier de clé privée illisible.') }
  const encrypted = /ENCRYPTED PRIVATE KEY|Proc-Type:\s*4,ENCRYPTED/.test(pem)
  try {
    const key = crypto.createPrivateKey(encrypted ? { key: pem, passphrase: await licensePassphrase(file) } : pem)
    if (key.asymmetricKeyType !== 'ec' || key.asymmetricKeyDetails.namedCurve !== 'prime256v1') throw new Error()
    return key.export({ type: 'pkcs8', format: 'pem' }).toString()
  } catch { throw new Error('Clé de licence illisible, passphrase incorrecte ou courbe non P-256. Aucun contenu affiché.') }
}
async function licenseKey(env, { root = ROOT, choose = select, prompt = question, readPem = readLicensePem, run = execute } = {}) {
  if (env.GF_PRIVATE_KEY) return
  const privateFile = path.join(root, 'keys/private.pem')
  const importFile = async file => {
    let stat
    try { stat = fs.statSync(file) } catch { throw new Error('Clé privée introuvable/illisible au chemin indiqué. Chemin proposé : keys/private.pem. Aucun remplacement de clé automatique.') }
    if (!stat.isFile()) throw new Error('Clé privée : fichier PEM requis, pas un dossier.')
    const value = Buffer.from(await readPem(file)).toString('base64')
    if (!core.licenseKeyMatches(value, core.embeddedLicenseKey(root))) throw new Error('Clé privée différente de la clé publique embarquée : aucun import ni changement d’autorité automatique.')
    env.GF_PRIVATE_KEY = value
  }
  if (fs.existsSync(privateFile)) {
    await importFile(privateFile)
    console.log(`Clé privée détectée et importée automatiquement : ${privateFile}. Identité publique vérifiée ; fichier original conservé.`)
    return
  }
  console.log('\nLicences : la clé privée doit correspondre à la clé publique embarquée.')
  const mode = await choose('Source de la clé', [
    { name: `Importer la clé privée existante (${privateFile}, recommandé)` },
    { name: 'Créer une NOUVELLE autorité (invalide la compatibilité des anciennes licences)' },
  ])
  if (mode.name.startsWith('Importer')) {
    const file = await prompt('Chemin local du fichier PEM (Entrée = chemin keys/private.pem proposé)', { defaultValue: privateFile })
    const resolved = path.resolve(root, file.replace(/^"(.*)"$/, '$1'))
    await importFile(resolved)
  } else {
    console.log('Cette opération modifie les ancrages PUBLICS du code. Les clients déjà installés et garagesite3 ne sont PAS mis à jour par cet outil.')
    if (await prompt('Pour confirmer une nouvelle autorité, saisir NOUVELLE-AUTORITE') !== 'NOUVELLE-AUTORITE') throw new Error('Création de clé annulée.')
    if (fs.existsSync(privateFile) || fs.existsSync(path.join(root, 'keys/public.pem'))) throw new Error('Des clés existent déjà : aucune rotation automatique autorisée.')
    const pair = crypto.generateKeyPairSync('ec', { namedCurve: 'prime256v1',
      privateKeyEncoding: { type: 'pkcs8', format: 'pem' }, publicKeyEncoding: { type: 'spki', format: 'pem' } })
    core.writePrivate(privateFile, pair.privateKey)
    core.writePrivate(path.join(root, 'keys/public.pem'), pair.publicKey)
    await run([path.join(root, 'scripts/sync-public-key.mjs')], { label: 'Synchronisation des ancrages publics' })
    env.GF_PRIVATE_KEY = Buffer.from(pair.privateKey).toString('base64')
    console.log('Nouvelle paire créée et ancrages publics synchronisés. Vérifiez le diff et mettez garagesite3 à jour avant publication.')
  }
}
async function advanced(env, names) {
  console.log('\nRéglages avancés : nom exact de variable, Entrée pour terminer. Valeur existante conservée sur Entrée ; « SUPPRIMER » pour la retirer.')
  console.log('Saisir GENERER comme valeur d’un secret symétrique pour une génération explicite sur confirmation. Jamais pour récupérer une clé perdue.')
  console.log('Variables de ce profil :\n' + names.join(', '))
  for (;;) {
    const name = await question('Variable à configurer')
    if (!name) return
    if (!names.includes(name)) { console.log('Variable inconnue ou non applicable à ce profil.'); continue }
    if (core.isSecret(name) && env[name]) {
      console.log('Changer une clé peut invalider les données ou les jetons. Pour une rotation SMTP, suivre la procédure dédiée.')
      if (!await yes(`Modifier explicitement ${name}`)) continue
    }
    const value = await question(`Valeur de ${name}`, { secret: core.isSecret(name), defaultValue: env[name] || '' })
    if (value === 'SUPPRIMER') delete env[name]
    else if (value === 'GENERER' && (core.GENERATED[name] || name === 'GF_EINVOICE_CREDENTIALS_KEY')) {
      console.log('Une nouvelle clé rend les anciennes données/jetons incompatibles. Pour la facturation électronique, uniquement sur une première configuration sans identifiants chiffrés.')
      if (await yes(`Générer explicitement une nouvelle valeur pour ${name}`)) {
        env[name] = crypto.randomBytes(32).toString(core.GENERATED[name] || 'base64')
        console.log(`${name} : générée, valeur masquée.`)
      }
    } else env[name] = value
  }
}
function childEnv(env, vercel) {
  const result = { ...process.env }
  // Ensure the selected profile wins over the shell and Prisma's .env loader.
  for (const n of allNames) result[n] = env[n] || ''
  result.ELECTRON = ''
  result.NODE_ENV = 'production'
  result.VERCEL = vercel ? '1' : ''
  return result
}
async function syncVercel(env, names, expectedRemote, { authorized = false } = {}) {
  // Re-read immediately before applying. Refuse concurrent changes; do not overwrite/rotate anything.
  const remote = await pullVercel()
  for (const n of names.filter(n => expectedRemote.hidden.has(n))) {
    if (env[n] !== expectedRemote.confirmedLocal[n]) throw new Error(`Vercel : ${n} est non relisible et a été modifiée localement. Aucune synchronisation ni rotation implicite autorisée.`)
  }
  for (const n of names) {
    if (remote.stamps[n] !== expectedRemote.stamps[n] ||
      (remote.values[n] || '') !== (expectedRemote.values[n] || '')) {
      throw new Error(`Vercel : ${n} a changé depuis la lecture initiale. Synchronisation arrêtée, relancez config.`)
    }
  }
  const plan = core.syncPlan(env, remote.values, names.filter(n => !remote.hidden.has(n)))
  if (plan.conflicts.length) throw new Error(`Vercel : conflit sur ${plan.conflicts.join(', ')}. Aucune valeur existante écrasée ; modification manuelle nécessaire.`)
  const additions = plan.additions.filter(n => !remote.present.has(n))
  if (!additions.length) { console.log('Vercel : variables déjà présentes (valeurs sensibles non comparables).'); return true }
  console.log(`Vercel production — ajouts uniquement : ${additions.join(', ')}.`)
  if (!authorized && !await yes('Ajouter ces variables au projet Vercel sélectionné')) return false
  // No --force / remove: even a concurrent creation is a failure, not an overwrite.
  for (const name of additions) {
    await tool('vercel', ['env', 'add', name, 'production', core.isSecret(name) ? '--sensitive' : '--no-sensitive', '--yes'],
      { input: env[name], label: `Vercel env add ${name}` })
    console.log(`  ${name} : ajoutée (masquée).`)
  }
  const actual = await pullVercel()
  for (const name of additions) {
    if (!actual.present.has(name) || (!actual.hidden.has(name) && actual.values[name] !== env[name])) {
      throw new Error(`Vercel : vérification de ${name} échouée.`)
    }
  }
  console.log('Présence des ajouts vérifiée. Les valeurs Sensitive ne sont pas relisibles : leur contenu ne peut pas être vérifié.')
  return true
}
function summarizeSqlDiff(output, schema) {
  // Only emit identifiers from the checked-in Prisma contract, never defaults,
  // connection strings, arbitrary database names or raw engine output.
  try { schema ||= fs.readFileSync(path.join(ROOT, 'prisma/server/schema.prisma'), 'utf8') }
  catch { return ['Différences détectées ; contrat local indisponible pour un résumé sûr.'] }
  const models = new Set([...schema.matchAll(/^model\s+(\w+)\s*\{/gm)].map(m => m[1]))
  const fields = new Set([...schema.matchAll(/^\s+(\w+)\s+[A-Z]\w*[?\[\]]*(?:\s|$)/gm)].map(m => m[1]))
  const result = []; let table = '', group = ''
  const clean = String(output).replace(/\x1b\[[0-9;]*m/g, '')
  for (const line of clean.split(/\r?\n/)) {
    const header = line.match(/^\[([+*-])\] (.+)$/)
    if (header) {
      group = header[2]; table = ''
      const changed = group.match(/^Changed the `(\w+)` table/)
      if (changed) {
        table = models.has(changed[1]) ? changed[1] : '(table hors contrat)'
        result.push(`Table ${table} : structure différente.`)
      }
      continue
    }
    const listed = line.match(/^\s+- (\w+)\s*$/)
    if (listed && /^(Added|Removed) tables$/.test(group)) {
      const name = models.has(listed[1]) ? listed[1] : '(table hors contrat)'
      result.push(`Table ${name} : ${group === 'Added tables' ? 'absente de la base, attendue par Prisma' : 'présente dans la base, absente du contrat Prisma'}.`)
      continue
    }
    if (!table) continue
    const column = line.match(/^\s+\[([+*-])\] (?:Added|Removed|Altered) column `(\w+)`/)
    if (column) {
      const name = fields.has(column[2]) ? column[2] : '(colonne hors contrat)'
      result.push(`  ${table} : colonne ${name} ${column[1] === '+' ? 'à ajouter' : column[1] === '-' ? 'à retirer selon Prisma' : 'différente (type, défaut ou nullabilité)'}.`)
      continue
    }
    const constraint = line.match(/^\s+\[([+*-])\] (?:Added|Removed|Changed|Renamed) (unique index|index|foreign key|primary key)/)
    if (constraint) result.push(`  ${table} : ${constraint[2]} ${constraint[1] === '+' ? 'à ajouter' : constraint[1] === '-' ? 'à retirer selon Prisma' : 'différent'}.`)
  }
  if (!result.length) return ['Différences détectées ; format non reconnu pour un résumé sûr. Aucune sortie brute affichée.']
  return result.length > 80 ? [...result.slice(0, 80), 'Résumé limité à 80 lignes.'] : result
}
async function diagnoseSql({ env, run = execute, root = ROOT, requestAccess = yes, connect = configureNeon } = {}) {
  const file = path.join(root, '.env.server.local')
