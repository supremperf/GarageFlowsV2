      aEnregistrer[n] = env[n]
      origines[n] = (expectedRemote.replacements && expectedRemote.replacements.has(n)) ? 'générée puis remplacée chez Vercel'
        : (expectedRemote.fourniesIci && expectedRemote.fourniesIci.has(n)) ? 'récupérée du fournisseur'
        : 'profil local'
    }
    if (!Object.keys(aEnregistrer).length) return
    const projet = projectSlug()
    auto.ecrireRecus(ROOT, { projet, valeurs: aEnregistrer, origines, stamps: actual.stamps || {} })
    console.log(`${Object.keys(aEnregistrer).length} empreinte(s) SHA-256 enregistrée(s) dans GarageFlow-configuration/secrets-receipt.json (aucune valeur en clair).`)
