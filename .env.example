# ══════════════════════════════════════════════════════════════════════════════
# GarageFlow — environment template
# Copy to .env and fill in REAL values. NEVER commit a real .env.
#   cp .env.example .env
#
# The three secret families below are SEPARATE on purpose — never reuse one
# value for another:
#   1. NEXTAUTH_SECRET       → signs sessions / JWTs
#   2. LICENSE_ADMIN_API_KEY → authenticates the Keygen to the admin API
#   3. keys/private.pem      → ECC key that signs license tokens (Keygen only)
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# Garage business database (desktop = local SQLite, cloud = its own DB)
# This holds ONLY the local garage data (jobs, clients, invoices…). Licenses are
# NOT stored here — they live on the central server (LICENSE_DATABASE_URL).
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ──────────────────────────────────────────────────────────────────────────────
# Central LICENSE database — PostgreSQL (source of truth for all licenses)
# Only required on the central server deployment (app.garageflows.fr).
# Desktop clients leave this EMPTY: they validate over HTTPS, never locally.
# ──────────────────────────────────────────────────────────────────────────────
# LICENSE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/garageflow_licenses?schema=public"

# ──────────────────────────────────────────────────────────────────────────────
# Session / JWT secret (NextAuth + gf_session cookie)
# Generate:  openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="https://app.garageflows.fr"
NEXTAUTH_SECRET="CHANGE_ME__openssl_rand_base64_32"

# ──────────────────────────────────────────────────────────────────────────────
# Admin API key — used ONLY by the Keygen GUI to call /api/admin/licenses/*
# MUST be different from NEXTAUTH_SECRET. Generate:  openssl rand -hex 32
# Enter the same value in the Keygen → "Serveur GarageFlow" tab.
# ──────────────────────────────────────────────────────────────────────────────
LICENSE_ADMIN_API_KEY="CHANGE_ME__openssl_rand_hex_32"

# ──────────────────────────────────────────────────────────────────────────────
# Central license server URL that DESKTOP clients validate against.
# Set in the packaged desktop build / client environment.
# ──────────────────────────────────────────────────────────────────────────────
# GF_LICENSE_SERVER="https://app.garageflows.fr"

# ──────────────────────────────────────────────────────────────────────────────
# Optional: server-side license signing (admin web UI "Generate" button).
# Base64-encoded PKCS8 PEM of the ECC P-256 private key. Leave unset when the
# Keygen is the only signer (recommended — keeps the private key off the server).
# ──────────────────────────────────────────────────────────────────────────────
# GF_PRIVATE_KEY="BASE64_PKCS8_PEM"

# ──────────────────────────────────────────────────────────────────────────────
# Portail client (optionnel) — falls back to NEXTAUTH_SECRET when unset.
# ──────────────────────────────────────────────────────────────────────────────
# GF_PORTAL_SECRET="CHANGE_ME__openssl_rand_base64_32"

# ──────────────────────────────────────────────────────────────────────────────
# Anthropic (OCR immatriculation, optionnel) — camera OCR disabled when unset.
# ──────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY="sk-ant-..."
