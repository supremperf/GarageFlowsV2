# GarageFlow — template d'environnement (app.garageflows.fr / GarageFlow.exe)
# Copiez ce fichier vers .env et remplissez les valeurs.
# ⚠️ Ce fichier est SUIVI par git : placeholders UNIQUEMENT, jamais de vrai secret.
#    L'app de bureau (Electron) génère automatiquement un NEXTAUTH_SECRET
#    aléatoire par installation au premier lancement.

# ──────────────────────────────────────────────────────────────────────────────
# Base de données
# ──────────────────────────────────────────────────────────────────────────────
# Bureau (Electron) : SQLite local.
DATABASE_URL="file:./dev.db"
# Cible web (app.garageflows.fr) : voir docs/PWA.md — nécessite un schéma
# PostgreSQL dédié (provider figé dans schema.prisma). Ex :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ──────────────────────────────────────────────────────────────────────────────
# NextAuth — secret de session (OBLIGATOIRE hors Electron)
# ──────────────────────────────────────────────────────────────────────────────
# Génération : openssl rand -base64 32
NEXTAUTH_URL="https://app.garageflows.fr"
NEXTAUTH_SECRET="CHANGE_ME_WITH_A_SECURE_RANDOM_VALUE"

# ──────────────────────────────────────────────────────────────────────────────
# Clé API admin GarageFlow (revoke-by-key) — DISTINCTE de NEXTAUTH_SECRET
# ──────────────────────────────────────────────────────────────────────────────
# Génération : openssl rand -hex 32
GARAGEFLOW_API_KEY="CHANGE_ME_WITH_A_SECURE_RANDOM_VALUE"

# ──────────────────────────────────────────────────────────────────────────────
# Secret HMAC de génération des clés de licence (scripts/generate-license-key.js)
# ──────────────────────────────────────────────────────────────────────────────
# ⚠️ Doit correspondre au secret embarqué dans le client de validation.
# Le schéma HMAC hérité (GF-XXXX-...) est déprécié — préférez la signature ECC
# (tokens GF2, ES256) déjà présente. Voir docs/SECURITY.md.
GF_LICENSE_MASTER_SECRET="CHANGE_ME_WITH_A_SECURE_RANDOM_VALUE"

# ──────────────────────────────────────────────────────────────────────────────
# Portail client / signature de devis (optionnel)
# ──────────────────────────────────────────────────────────────────────────────
# Si absent, NEXTAUTH_SECRET est utilisé. Aucun secret par défaut n'est toléré.
# GF_PORTAL_SECRET="CHANGE_ME_openssl_rand_base64_32"

# ──────────────────────────────────────────────────────────────────────────────
# Serveur de licences / control-plane (client desktop → api.garageflows.fr)
# ──────────────────────────────────────────────────────────────────────────────
# GF_LICENSE_SERVER="https://api.garageflows.fr"

# ──────────────────────────────────────────────────────────────────────────────
# Anthropic (OCR immatriculation, optionnel)
# ──────────────────────────────────────────────────────────────────────────────
# Sans cette clé, le bouton caméra OCR est désactivé silencieusement.
# ANTHROPIC_API_KEY="sk-ant-..."
