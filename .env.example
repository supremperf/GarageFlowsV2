# ═════════════════════════════════════════════════════════════════════════════
# GarageFlow (desktop Electron + Next.js) — modèle d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs :  cp .env.example .env
#
# ⚠️ SÉCURITÉ : ce fichier ne contient QUE des placeholders. Ne committez JAMAIS
#    de vraie valeur. En packaging Electron, un secret de session unique est
#    généré automatiquement au premier lancement s'il n'est pas fourni ici.
# ═════════════════════════════════════════════════════════════════════════════

# ── Base de données (Prisma / SQLite) ─────────────────────────────────────────
# Dev : fichier local. En Electron packagé, l'URL est calculée automatiquement
# vers %APPDATA%/GarageFlow/garageflow.db (ne pas définir en prod desktop).
# Obligatoire (dev). Format : file:./chemin.db
DATABASE_URL="file:./dev.db"

# ── NextAuth (authentification des utilisateurs du garage) ────────────────────
# NEXTAUTH_URL : URL de base du serveur. En Electron, forcé à http://127.0.0.1:4028.
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET : clé HMAC de signature des sessions JWT et du cookie gf_session.
#   Générer : openssl rand -base64 32
#   OBLIGATOIRE en déploiement web. En Electron packagé, s'il est absent, un secret
#   aléatoire par-installation est généré et stocké dans userData (gf_session_secret).
#   NE JAMAIS réutiliser la même valeur entre déploiements ni la committer.
NEXTAUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"

# ── Portail client (liens de suivi + signature de devis) ──────────────────────
# GF_PORTAL_SECRET : secret DÉDIÉ signant les jetons du portail et de signature.
#   Générer : openssl rand -base64 32
#   Doit être DISTINCT de NEXTAUTH_SECRET. Si absent, l'app dérive un secret
#   propre à l'installation (jamais la constante par défaut).
GF_PORTAL_SECRET="CHANGE_ME_openssl_rand_base64_32"

# ── Serveur de licences / control-plane (garagesite3) ─────────────────────────
# GF_LICENSE_SERVER : URL HTTPS du control-plane (heartbeat licence, mises à jour,
#   notifications, crash). Optionnel — sans lui, l'app fonctionne hors-ligne.
#   DOIT être en https:// en production (les URLs http sont refusées).
# GF_LICENSE_SERVER="https://app.garageflows.fr"
# GF_UPDATE_CHANNEL : canal de mise à jour (stable | beta). Défaut : stable.
# GF_UPDATE_CHANNEL="stable"

# ── Clé API GarageFlow (utilisée par le Gestionnaire de Licences / Keygen) ────
# Générer : openssl rand -hex 32   (DISTINCTE de NEXTAUTH_SECRET)
# Sert à l'endpoint /api/admin/licenses/revoke-by-key (en-tête x-gf-key).
GARAGEFLOW_API_KEY="CHANGE_ME_openssl_rand_hex_32"

# ── Anthropic (OCR carte grise / plaque, décodage VIN assisté, devis IA) ──────
# Sans cette clé, les fonctions IA (OCR, autofill plaque) sont désactivées
# silencieusement — l'app reste pleinement fonctionnelle.
# Où l'obtenir : https://console.anthropic.com → API Keys. Format : sk-ant-...
# ANTHROPIC_API_KEY="sk-ant-..."

# ── (Optionnel) Signature de licences hors-ligne : base64 du PEM PKCS8 ECC ────
# Réservé au Keygen. Ne jamais déployer côté client.
# GF_PRIVATE_KEY="BASE64_PKCS8_PEM"

# ═════════════════════════════════════════════════════════════════════════════
# Variables INJECTÉES AUTOMATIQUEMENT par le processus Electron (electron/main.js)
# au démarrage — ne pas définir manuellement, documentées ici pour référence :
#   GF_DB_MAC_SECRET        Secret dérivé du HWID pour vérifier l'intégrité DB.
#   GF_INTERNAL_EXPORT_KEY  Clé éphémère (par-session) des endpoints /api/internal/*.
#   GF_PHOTOS_DIR           Répertoire de stockage des photos (userData/photos).
#   GF_APP_DATA             Répertoire userData de l'application.
#   ELECTRON=1              Indique l'exécution sous Electron.
# ═════════════════════════════════════════════════════════════════════════════
