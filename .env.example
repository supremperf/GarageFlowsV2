# GarageFlow — template d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs.
# Commande rapide : cp .env.example .env

# ──────────────────────────────────────────────────────────────────────────────
# Base de données SQLite
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ──────────────────────────────────────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────────────────────────────────────
# Génération (valeur UNIQUE, jamais partagée, jamais committée) :
# openssl rand -base64 32
NEXTAUTH_URL="https://app.garageflows.fr"
NEXTAUTH_SECRET="CHANGE_ME__openssl_rand_base64_32"

# ──────────────────────────────────────────────────────────────────────────────
# Clé API GarageFlow (Keygen GUI)
# ──────────────────────────────────────────────────────────────────────────────
# Génération :
# openssl rand -hex 32
#
# Cette clé est utilisée UNIQUEMENT par le Gestionnaire de Licences
# (keygen_gui.py) pour communiquer avec le serveur GarageFlow.
#
# À saisir dans l'onglet :
# 🌐 Serveur GarageFlow
# → Clé API (GARAGEFLOW_API_KEY du serveur)
#
# IMPORTANT : cette clé DOIT être différente de NEXTAUTH_SECRET.
GARAGEFLOW_API_KEY="CHANGE_ME__openssl_rand_hex_32"

# ──────────────────────────────────────────────────────────────────────────────
# Portail client (optionnel)
# ──────────────────────────────────────────────────────────────────────────────
# Si absent, NEXTAUTH_SECRET est utilisé comme fallback.
# GF_PORTAL_SECRET="CHANGE_ME_openssl_rand_base64_32"

# ──────────────────────────────────────────────────────────────────────────────
# Anthropic (OCR immatriculation, optionnel)
# ──────────────────────────────────────────────────────────────────────────────
# Sans cette clé, le bouton caméra OCR est désactivé silencieusement.
# ANTHROPIC_API_KEY="sk-ant-..."