# GarageFlow — template d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs.
# ⚠️ Ce fichier est SUIVI par git : n'y mettez QUE des placeholders, JAMAIS de
#    vraie valeur secrète. setup-dev.js génère automatiquement un NEXTAUTH_SECRET
#    aléatoire à l'installation.

# ──────────────────────────────────────────────────────────────────────────────
# Base de données SQLite
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ──────────────────────────────────────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────────────────────────────────────
# Génération : openssl rand -base64 32
# Laissé VIDE volontairement — généré automatiquement par setup-dev.js, ou à
# renseigner en production (variable d'environnement, jamais dans le dépôt).
NEXTAUTH_URL="https://app.garageflows.fr"
NEXTAUTH_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Serveur de licences distant (control-plane api.garageflows.fr)
# ──────────────────────────────────────────────────────────────────────────────
# Base HTTPS du serveur officiel des licences interrogé par le client Electron.
# GF_LICENSE_SERVER="https://api.garageflows.fr"

# ──────────────────────────────────────────────────────────────────────────────
# Clé API GarageFlow (Keygen GUI → serveur de licences)
# ──────────────────────────────────────────────────────────────────────────────
# Génération : openssl rand -hex 32   (DISTINCTE de NEXTAUTH_SECRET)
GARAGEFLOW_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Portail client (optionnel)
# ──────────────────────────────────────────────────────────────────────────────
# Si absent, NEXTAUTH_SECRET est utilisé (jamais de repli codé en dur).
# GF_PORTAL_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Anthropic (OCR immatriculation, optionnel)
# ──────────────────────────────────────────────────────────────────────────────
# Sans cette clé, le bouton caméra OCR est désactivé silencieusement.
# ANTHROPIC_API_KEY=
