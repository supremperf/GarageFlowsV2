# GarageFlow — template d'environnement
# Copiez ce fichier vers .env et remplissez les valeurs.
# Commande rapide : cp .env.example .env

# ──────────────────────────────────────────────────────────────────────────────
# Base de données SQLite
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ──────────────────────────────────────────────────────────────────────────────
# NextAuth
# ──────────────────────────────────────────────────────────────────────────────
# Génération :
# openssl rand -base64 32
NEXTAUTH_URL="https://app.garageflows.fr"
NEXTAUTH_SECRET="3jvKZFYUKLjGTI/mneyeY0fUN/FNp9d1XzOgnOij7+I="

# ──────────────────────────────────────────────────────────────────────────────
# Clé API GarageFlow (Keygen GUI)
# ──────────────────────────────────────────────────────────────────────────────
# Génération :
# openssl rand -hex 32
#
# Cette clé est utilisée UNIQUEMENT par le Gestionnaire de Licences
# (keygen_gui.py) pour communiquer avec le serveur GarageFlow.
#
# À saisir dans l'onglet :
# 🌐 Serveur GarageFlow
# → Clé API (GARAGEFLOW_API_KEY du serveur)
#
GARAGEFLOW_API_KEY="3jvKZFYUKLjGTI/mneyeY0fUN/FNp9d1XzOgnOij7+I="

# ──────────────────────────────────────────────────────────────────────────────
# Portail client (optionnel)
# ──────────────────────────────────────────────────────────────────────────────
# Si absent, NEXTAUTH_SECRET est utilisé comme fallback.
# GF_PORTAL_SECRET="CHANGE_ME_openssl_rand_base64_32"

# ──────────────────────────────────────────────────────────────────────────────
# Anthropic (OCR immatriculation, optionnel)
# ──────────────────────────────────────────────────────────────────────────────
# Sans cette clé, le bouton caméra OCR est désactivé silencieusement.
# ANTHROPIC_API_KEY="sk-ant-..."

# ──────────────────────────────────────────────────────────────────────────────
# Mises à jour de l'application (client Electron)
# ──────────────────────────────────────────────────────────────────────────────
# Serveur central des mises à jour. Par défaut, GF_LICENSE_SERVER est réutilisé
# (app.garageflows.fr héberge licences ET mises à jour). Le client interroge
# /api/update/latest au démarrage puis toutes les heures.
# GF_UPDATE_SERVER="https://app.garageflows.fr"
# GF_UPDATE_CHANNEL="stable"          # stable | beta

# ──────────────────────────────────────────────────────────────────────────────
# Durcissement / intégrité (production — voir docs/SECURITY-HARDENING.md)
# ──────────────────────────────────────────────────────────────────────────────
# Vérification d'intégrité au démarrage : audit (défaut, journalise) | enforce
# (arrêt si altération) | off. Passer à « enforce » APRÈS avoir validé un build.
# GF_INTEGRITY_MODE="audit"
# GF_ANTIDEBUG="0"                    # 1 = bloquer si débogueur détecté (enforce)