# Next.js
.next/
out/
build/

# Dependencies
node_modules/

# Env
.env
.env.local
.env.*.local

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Clients Prisma générés (desktop → node_modules, serveur → src/generated)
src/generated/

# Python (keygen) — caches et artefacts de compilation
__pycache__/
*.pyc
*.pyo

# Artefacts de tests locaux (ex. dump Redis)
dump.rdb

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
prisma/prisma/
prisma/*.db
# Template DB is committed so Windows builds don't need prisma db push
!prisma/garageflow-template.db

# Electron build output
dist/

# License signing keys — CRITICAL: NEVER commit private keys OR runtime state.
keys/private.pem
keys/*.pem
# Keygen runtime state — contains real API keys / issued license tokens.
keys/*.json
keys/licenses_db.json
keys/server_config.json

# Generated icons (keep SVG source, not binaries)
# icon.ico
# icon.png
icon.icns

# App logs
*.log
.claude/

# Runtime update files (admin-published installer + metadata)
gf_update.json
/updates/
/dev.db

# Captures E2E générées localement (livrées séparément, pas versionnées)
e2e/shots/
playwright-report/

# Sorties des scripts de configuration/rotation — peuvent contenir des secrets en clair
GarageFlow-configuration/
API générées/
*.pfx
*.p12
test-results/
