# Next.js
.next/
out/
build/

# Dependencies
# Les deux formes sont nécessaires. `node_modules/` (barre finale) ne
# correspond QU'À un répertoire : dans un clone où `node_modules` est un LIEN
# SYMBOLIQUE vers l'installation partagée du poste, git ne l'ignore pas et le
# voit comme un fichier non suivi. `git stash -u` et `git clean -fd`
# SUPPRIMENT alors le lien (vérifié), ce qui casse l'installation partagée et
# fait échouer build et tests jusqu'à un `npm ci`. La forme sans barre couvre
# aussi bien le lien que le répertoire.
node_modules
node_modules/

# Env
.env
.env.local
.env.*.local

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Clients Prisma générés (desktop → node_modules, serveur → src/generated)
src/generated/

# Python (keygen) — caches et artefacts de compilation
__pycache__/
*.pyc
*.pyo

# Artefacts de tests locaux (ex. dump Redis)
dump.rdb

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
prisma/prisma/
prisma/*.db
# Template DB is committed so Windows builds don't need prisma db push
!prisma/garageflow-template.db

# Electron build output
dist/

# License signing keys — CRITICAL: NEVER commit private keys OR runtime state.
keys/private.pem
keys/*.pem
# Keygen runtime state — contains real API keys / issued license tokens.
keys/*.json
keys/licenses_db.json
keys/server_config.json

# Generated icons (keep SVG source, not binaries)
# icon.ico
# icon.png
icon.icns

# App logs
*.log
.claude/

# Runtime update files (admin-published installer + metadata)
gf_update.json
/updates/
/dev.db

# Captures E2E générées localement (livrées séparément, pas versionnées)
e2e/shots/
playwright-report/

# Sorties des scripts de configuration/rotation — peuvent contenir des secrets en clair
GarageFlow-configuration/
API générées/
*.pfx
*.p12
test-results/

# Vérification (V13.1) : baseline.json est SUIVI (métadonnées canoniques) ;
# le rapport brut vitest est un artefact local volumineux, non suivi.
artifacts/verification/test-results.json

# Lien de projet Vercel : créé par `vercel link`, propre à la machine.
# Non suivi pour qu'un déploiement local ne réécrive pas la cible de tous.
.vercel/

# Bases SQLite jetables créées par les tests d'intégration à la racine.
# Sans cette règle, elles restent dans `git status` après chaque `npm test` et
# un `git add -A` les committerait — 20 bases de test dans le dépôt.
.tmp-*.db
.tmp-*.db-journal

# Build artifact — generated at release time (scripts/generate-release-manifest.mjs), binds to HEAD
release-manifest.json

# Release artifacts (build output — not committed)
dist-artifact/
